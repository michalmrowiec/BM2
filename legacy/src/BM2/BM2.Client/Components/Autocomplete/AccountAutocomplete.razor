@using BM2.Shared.DTOs
@inherits AutocompleteBase<AccountDTO>

@{
    base.BuildRenderTree(__builder);
}

@code {
    [Parameter] public bool OnlyActive { get; set; }

    protected override void OnInitialized()
    {
        if(OnlyActive)
            Uri = "api/v1/accounts/active";
        else
            Uri = "api/v1/accounts/all";

         SearchFunc = (entity, value) => entity.AccountName.Contains(value, StringComparison.InvariantCultureIgnoreCase);
        OrderFunc = x => x.AccountName;
        base.OnInitialized();
    }
}
