@page "/records2"

@using System.Net
@using BM2.Client.Components
@using BM2.Client.Services.DisplayServices
@using BM2.Client.Services.States
@using BM2.Shared
@using BM2.Shared.DTOs
@using Newtonsoft.Json
@implements IDisposable

@inject IRecordService RecordService
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject IAlertService AlertService
@inject IWalletSelectionState WalletSelectionState
@inject IRecordEventService RecordEventService

<MudStack Row AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-2">
    <MudTextField @bind-Value="_filter.SearchText" Placeholder="Search by name..." Clearable
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnDebounceIntervalElapsed="RefreshTable" DebounceInterval="400"/>

    @* <MudButton Variant="Variant.Filled" Color="Color.Primary" *@
    @*            StartIcon="@Icons.Material.Filled.FilterList" OnClick="ToggleFilterDrawer"> *@
    @*     Filters *@
    @* </MudButton> *@

    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
        <MudButton StartIcon="@Icons.Material.Filled.FilterList" OnClick="ToggleFilterDrawer">
            Filters
        </MudButton>
        <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
            <MudMenuItem OnClick="@(async _ =>
                                  {
                                      SetDateRange("CurrentMonth");
                                      await ApplyFilters();
                                  })">This Month
            </MudMenuItem>
            <MudMenuItem OnClick="@(async _ =>
                                  {
                                      SetDateRange("LastMonth");
                                      await ApplyFilters();
                                  })">Last Month
            </MudMenuItem>
            <MudMenuItem OnClick="@(async _ =>
                                  {
                                      SetDateRange("CurrentYear");
                                      await ApplyFilters();
                                  })">This Year
            </MudMenuItem>
            <MudMenuItem OnClick="@(async _ =>
                                  {
                                      SetDateRange("LastYear");
                                      await ApplyFilters();
                                  })">Last Year
            </MudMenuItem>
        </MudMenu>
    </MudButtonGroup>
</MudStack>

<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
    <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        @if (!_filter.IsEmpty())
        {
            <MudIconButton Icon="@Icons.Material.Filled.FilterListOff"
                           Color="Color.Default"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           OnClick="ResetAllFilters"/>
        }
        @if (_filter.DateFrom.HasValue || _filter.DateTo.HasValue)
        {
            <MudChip T="string" OnClose="ClearDateFilter" Color="Color.Secondary" Variant="Variant.Text"
                     Icon="@Icons.Material.Outlined.CalendarMonth">
                @_filter.DateFrom?.ToString("dd.MM.yyyy") - @_filter.DateTo?.ToString("dd.MM.yyyy")
            </MudChip>
        }
        @foreach (var accId in _filter.AccountIds)
        {
            var accountName = _availableAccounts.FirstOrDefault(c => c.Id == accId)?.AccountName ?? "Acc";
            <MudChip T="Guid" Value="accId" OnClose="(c) => RemoveAccountFilter(c.Value)" Color="Color.Tertiary"
                     Variant="Variant.Text"
                     Icon="@Icons.Material.Outlined.AccountBalance">
                @accountName
            </MudChip>
        }
        @foreach (var staId in _filter.StatusIds)
        {
            var statusName = _availableStatuses.FirstOrDefault(c => c.Id == staId)?.RecordStatusName ?? "Sta";
            <MudChip T="Guid" Value="staId" OnClose="(c) => RemoveStatusFilter(c.Value)" Color="Color.Warning"
                     Variant="Variant.Text"
                     Icon="@Icons.Material.Outlined.FlagCircle">
                @statusName
            </MudChip>
        }
        @foreach (var catId in _filter.CategoryIds)
        {
            var categoryName = _availableCategories.FirstOrDefault(c => c.Id == catId)?.CategoryName ?? "Cat";
            <MudChip T="Guid" Value="catId" OnClose="(c) => RemoveCategoryFilter(c.Value)" Color="Color.Info"
                     Variant="Variant.Text"
                     Icon="@Icons.Material.Outlined.Category">
                @categoryName
            </MudChip>
        }

        @if (_filter.TagIds.Any())
        {
            <MudChip T="string"
                     Color="Color.Surface"
                     Variant="Variant.Outlined"
                     Icon="@(_filter.TagOperator == TransactionFilter.LogicalOperator.And ? Icons.Material.Outlined.Link : Icons.Material.Outlined.LinkOff)"
                     OnClick="ToggleTagOperatorAsync"
                     Style="cursor: pointer;">
                @(_filter.TagOperator == TransactionFilter.LogicalOperator.And ? "All tags" : "Any tag")
            </MudChip>

            @foreach (var tagId in _filter.TagIds)
            {
                var tagName = _availableTags.FirstOrDefault(c => c.Id == tagId)?.TagName ?? "Tag";
                <MudChip T="Guid" Value="tagId" OnClose="(c) => RemoveTagFilter(c.Value)" Color="Color.Surface"
                         Variant="Variant.Text"
                         Icon="@Icons.Material.Outlined.Discount">
                    @tagName
                </MudChip>
            }
        }
    </MudStack>
    @* @if (!_filter.IsEmpty()) *@
    @* { *@
    @*     <div> *@
    @*     <MudButton StartIcon="@Icons.Material.Filled.FilterListOff" *@
    @*                Color="Color.Default" *@
    @*                Size="Size.Medium" *@
    @*                Variant="Variant.Outlined" *@
    @*                OnClick="ResetAllFilters" Class="text-nowrap"> *@
    @*         Clear filters *@
    @*     </MudButton></div> *@
    @* } *@
</MudStack>

<MudTable ServerData="LoadTableData" T="RecordDTO" @ref="_table" Dense="false" Hover FixedHeader Height="70vh">
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortLabel="RecordDateTime" T="RecordDTO" InitialDirection="SortDirection.Descending">
                Date
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Name" T="RecordDTO">Name</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Amount" T="RecordDTO">Amount / Planned</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Status" T="RecordDTO">Status</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Account" T="RecordDTO">Account</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Category" T="RecordDTO">Category</MudTableSortLabel>
        </MudTh>
        <MudTh>Tags</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Date">@context.RecordDateTime.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Amount">
            <strong>@context.Amount</strong> @(context.PlannedAmount.HasValue ? "/ " + context.PlannedAmount : "") @context.Currency?.Symbol
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Icon="@context.Status!.GetIconForRecordStatus()"
                     Color="@context.Status!.GetColorForRecordStatus()">
                @context.Status!.ToString()
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Account">@GetAccountName(context.AccountId)</MudTd>
        <MudTd DataLabel="Categories">@context.Category?.CategoryName</MudTd>
        <MudTd DataLabel="Tags">
            @foreach (var tag in context.Tags)
            {
                <MudChip T="string"
                         Color="Color.Surface"
                         Variant="Variant.Outlined"
                         Size="Size.Small">
                    @tag.TagName
                </MudChip>
            }
        </MudTd>
        <MudTd DataLabel="">
            <MudIconButton @onclick="@(async () => await OpenUpdateRecordDialogAsync(context, DialogFormType.Clone))"
                           Icon="@Icons.Material.Outlined.CopyAll"
                           Size="@Size.Small"/>
            <MudIconButton @onclick="@(async () => await OpenUpdateRecordDialogAsync(context, DialogFormType.Edit))"
                           Icon="@Icons.Material.Outlined.Edit"
                           Size="@Size.Small"/>
            <MudIconButton @onclick="@(async () => await DeleteRecordAsync(context))"
                           Icon="@Icons.Material.Outlined.Delete"
                           Color="@Color.Error"
                           Size="@Size.Small"/>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="Records:"/>
    </PagerContent>
</MudTable>

<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Right" Elevation="1" Variant="DrawerVariant.Temporary" Width="320px">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Advanced filters</MudText>
    </MudDrawerHeader>
    <div class="pa-4 d-flex flex-column gap-5">
        @* <div class="d-flex align-center justify-space-between mt-2"> *@
        @*     <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Quick ranges:</MudText> *@
        @*     <MudMenu StartIcon="@Icons.Material.Filled.DateRange" *@
        @*              EndIcon="@Icons.Material.Filled.ArrowDropDown" *@
        @*              Label="Select Range" *@
        @*              Color="Color.Primary" *@
        @*              Variant="Variant.Outlined" *@
        @*              Size="Size.Small"> *@
        @*         <MudMenuItem OnClick="@(async _ => await SetDateRange("CurrentMonth"))">This Month</MudMenuItem> *@
        @*         <MudMenuItem OnClick="@(async _ => await SetDateRange("LastMonth"))">Last Month</MudMenuItem> *@
        @*         <MudMenuItem OnClick="@(async _ => await SetDateRange("CurrentYear"))">This Year</MudMenuItem> *@
        @*         <MudMenuItem OnClick="@(async _ => await SetDateRange("LastYear"))">Last Year</MudMenuItem> *@
        @*     </MudMenu> *@
        @* </div> *@

        <div class="d-flex flex-column gap-1">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Quick ranges:</MudText>
            <div class="d-flex flex-wrap gap-1">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(_ => SetDateRange("CurrentMonth"))">
                    This Month
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(_ => SetDateRange("LastMonth"))">
                    Last Month
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(_ => SetDateRange("CurrentYear"))">
                    This Year
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(_ => SetDateRange("LastYear"))">Last
                    Year
                </MudButton>
            </div>
        </div>

        <MudDatePicker Label="From" @bind-Date="_filter.DateFrom" Clearable/>
        <MudDatePicker Label="To" @bind-Date="_filter.DateTo" Clearable/>

        <MudSelect T="Guid" Label="Accounts" MultiSelection="true"
                   @bind-SelectedValues="_selectedAccounts"
                   ToStringFunc="@GetAccountName">
            @foreach (var acc in _availableAccounts)
            {
                <MudSelectItem T="Guid" Value="@acc.Id">@acc.AccountName</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid" Label="Statuses" MultiSelection="true"
                   @bind-SelectedValues="_selectedStatuses"
                   ToStringFunc="@GetStatusName">
            @foreach (var sta in _availableStatuses)
            {
                <MudSelectItem T="Guid" Value="@sta.Id">@sta.RecordStatusName</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid" Label="Categories" MultiSelection="true"
                   @bind-SelectedValues="_selectedCategories"
                   ToStringFunc="@GetCategoryName">
            @foreach (var cat in _availableCategories)
            {
                <MudSelectItem T="Guid" Value="@cat.Id">@cat.CategoryName</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid" Label="Tags" MultiSelection="true"
                   @bind-SelectedValues="_selectedTags"
                   ToStringFunc="@GetTagName">
            @foreach (var tag in _availableTags)
            {
                <MudSelectItem T="Guid" Value="@tag.Id">@tag.TagName</MudSelectItem>
            }
        </MudSelect>

        @if (_selectedTags.Any())
        {
            <MudSwitch T="bool"
                       Value="@(_logicalTagOperator == TransactionFilter.LogicalOperator.And)"
                       ValueChanged="@((bool isAnd) => _logicalTagOperator = isAnd ? TransactionFilter.LogicalOperator.And : TransactionFilter.LogicalOperator.Or)"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       Label="@(_logicalTagOperator == TransactionFilter.LogicalOperator.And ? "Match: Require all tags (AND)" : "Match: Any tag (OR)")"/>
        }

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ResetAllFilters"
                       Disabled="_filter.IsEmpty()">Reset
            </MudButton>
            <MudSpacer/>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Apply</MudButton>
        </div>
    </div>
</MudDrawer>

@code {
    private MudTable<RecordDTO> _table;
    private bool _drawerOpen;
    private TransactionFilter _filter = new();

    // Zmienne pomocnicze dla UI
    private IReadOnlyCollection<Guid> _selectedStatuses = new HashSet<Guid>();
    private List<RecordStatusDTO> _availableStatuses = [];

    private IReadOnlyCollection<Guid> _selectedCategories = new HashSet<Guid>();
    private List<CategoryWalletRelationDTO> _availableCategories = [];

    private IReadOnlyCollection<Guid> _selectedAccounts = new HashSet<Guid>();
    private List<AccountBasicDTO> _availableAccounts = [];

    private IReadOnlyCollection<Guid> _selectedTags = new HashSet<Guid>();
    private List<TagDTO> _availableTags = [];
    private TransactionFilter.LogicalOperator _logicalTagOperator = TransactionFilter.LogicalOperator.Or;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            WalletSelectionState.OnWalletChanged += _table.ReloadServerData;
            RecordEventService.OnRecordsChanged += _table.ReloadServerData;

            await GetAccounts();
            await GetStatuses();
            await GetCategories();
            await GetTags();
        }
    }

    protected override void OnInitialized()
    {
        // Ustawienie domyślnego filtra na aktualny miesiąc przy starcie
        var dzis = DateTime.Today;
        _filter.DateFrom = new DateTime(dzis.Year, dzis.Month, 1);
        _filter.DateTo = _filter.DateFrom.Value.AddMonths(1).AddDays(-1);
    }

    private async Task GetStatuses()
    {
        var response = await ApiClient.Get("api/v1/recordStatuses/for-records");
        var r = await response.Content.ReadAsStringAsync();
        _availableStatuses = JsonConvert.DeserializeObject<List<RecordStatusDTO>>(r) ?? [];
        StateHasChanged();
    }

    private async Task GetAccounts()
    {
        var response = await ApiClient.Get("api/v1/accounts");
        var r = await response.Content.ReadAsStringAsync();
        _availableAccounts = JsonConvert.DeserializeObject<List<AccountBasicDTO>>(r) ?? [];
        StateHasChanged();
    }

    private async Task GetCategories()
    {
        var response2 = await ApiClient.Get("api/v1/categories/wallet-relations");
        var responseString2 = await response2.Content.ReadAsStringAsync();
        _availableCategories = JsonConvert.DeserializeObject<List<CategoryWalletRelationDTO>>(responseString2) ?? [];
        StateHasChanged();
    }

    private async Task GetTags()
    {
        var response2 = await ApiClient.Get("api/v1/tags/wallet-relations");
        var responseString2 = await response2.Content.ReadAsStringAsync();
        _availableTags = JsonConvert.DeserializeObject<List<TagDTO>>(responseString2) ?? [];
        StateHasChanged();
    }

    private async Task<TableData<RecordDTO>> LoadTableData(TableState state, CancellationToken cancellationToken = default)
    {
        string sortLabel = string.IsNullOrEmpty(state.SortLabel) ? "RecordDateTime" : state.SortLabel;
        bool isDescending = string.IsNullOrEmpty(state.SortLabel) ? true : (state.SortDirection == SortDirection.Descending);

        (List<RecordDTO> Items, int TotalCount) result = ([], 0);
        if (WalletSelectionState.SelectedWallet?.Id is not null)
        {
            result = await RecordService.GetPagedRecordsAsync(
                state.Page,
                state.PageSize,
                sortLabel,
                isDescending,
                WalletSelectionState.SelectedWallet!.Id,
                _filter);
        }

        return new TableData<RecordDTO> { TotalItems = result.TotalCount, Items = result.Items };
    }

    private void ToggleFilterDrawer() => _drawerOpen = !_drawerOpen;

    private Task RefreshTable() => _table.ReloadServerData();

    private Task ApplyFilters()
    {
        _filter.AccountIds = _selectedAccounts.ToList();
        _filter.StatusIds = _selectedStatuses.ToList();
        _filter.CategoryIds = _selectedCategories.ToList();
        _filter.TagIds = _selectedTags.ToList();
        _filter.TagOperator = _logicalTagOperator;
        _drawerOpen = false;
        return RefreshTable();
    }

    private Task RemoveStatusFilter(Guid id)
    {
        _filter.StatusIds.Remove(id);
        _selectedStatuses = _selectedStatuses.Where(x => x != id).ToList();
        return RefreshTable();
    }

    private Task RemoveAccountFilter(Guid id)
    {
        _filter.AccountIds.Remove(id);
        _selectedAccounts = _selectedAccounts.Where(x => x != id).ToList();
        return RefreshTable();
    }

    private Task RemoveCategoryFilter(Guid id)
    {
        _filter.CategoryIds.Remove(id);
        _selectedCategories = _selectedCategories.Where(x => x != id).ToList();
        return RefreshTable();
    }

    private Task RemoveTagFilter(Guid id)
    {
        _filter.TagIds.Remove(id);
        _selectedTags = _selectedTags.Where(x => x != id).ToList();
        return RefreshTable();
    }

    private Task ClearDateFilter()
    {
        _filter.DateFrom = null;
        _filter.DateTo = null;
        return RefreshTable();
    }

    private Task ResetAllFilters()
    {
        _filter = new TransactionFilter() { SearchText = _filter.SearchText };
        _selectedAccounts = new HashSet<Guid>();
        _selectedStatuses = new HashSet<Guid>();
        _selectedCategories = new HashSet<Guid>();
        _selectedTags = new HashSet<Guid>();
        _drawerOpen = false;
        return RefreshTable();
    }

    private string GetStatusName(Guid id)
    {
        var status = _availableStatuses.FirstOrDefault(c => c.Id == id);
        return status?.RecordStatusName ?? string.Empty;
    }

    private string GetAccountName(Guid id)
    {
        var account = _availableAccounts.FirstOrDefault(c => c.Id == id);
        return account?.AccountName ?? string.Empty;
    }

    private string GetCategoryName(Guid id)
    {
        var category = _availableCategories.FirstOrDefault(c => c.Id == id);
        return category?.CategoryName ?? string.Empty;
    }

    private string GetTagName(Guid id)
    {
        var tag = _availableTags.FirstOrDefault(c => c.Id == id);
        return tag?.TagName ?? string.Empty;
    }

    private Task OpenUpdateRecordDialogAsync(RecordDTO record, DialogFormType formType = DialogFormType.Edit)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var parameters = new DialogParameters<AddRecordDialogForm>
        {
            {
                x => x.FuncsOnCreated, [EventCallback.Factory.Create(this, RefreshTable)]
            },
            {
                x => x.FormType, formType
            },
            {
                x => x.RecordToUpdate, record
            }
        };
        return DialogService.ShowAsync<AddRecordDialogForm>(null, parameters, options);
    }

    private async Task DeleteRecordAsync(RecordDTO record)
    {
        var confirmed = await UiService.ConfirmDeleteAsync(
            title: "Delete Record",
            message: $"Do you want to delete the record '{record.Name}'?");

        if (!confirmed) return;

        var response = await ApiClient.Delete($"api/v1/records/{record.Id}");

        if (response.StatusCode == HttpStatusCode.OK)
        {
            UiService.ShowDeleteSuccess(record.Name);
            await RefreshTable();
            return;
        }

        await response.HandleFailure(AlertService);
    }

    private Task ToggleTagOperatorAsync()
    {
        _filter.TagOperator = _filter.TagOperator == TransactionFilter.LogicalOperator.And
            ? TransactionFilter.LogicalOperator.Or
            : TransactionFilter.LogicalOperator.And;

        _logicalTagOperator = _filter.TagOperator;

        return RefreshTable();
    }

    private void SetDateRange(string rangeType)
    {
        var today = DateTime.Today;

        switch (rangeType)
        {
            case "CurrentMonth":
                _filter.DateFrom = new DateTime(today.Year, today.Month, 1);
                _filter.DateTo = _filter.DateFrom.Value.AddMonths(1).AddDays(-1);
                break;

            case "LastMonth":
                var lastMonth = today.AddMonths(-1);
                _filter.DateFrom = new DateTime(lastMonth.Year, lastMonth.Month, 1);
                _filter.DateTo = _filter.DateFrom.Value.AddMonths(1).AddDays(-1);
                break;

            case "CurrentYear":
                _filter.DateFrom = new DateTime(today.Year, 1, 1);
                _filter.DateTo = new DateTime(today.Year, 12, 31);
                break;

            case "LastYear":
                _filter.DateFrom = new DateTime(today.Year - 1, 1, 1);
                _filter.DateTo = new DateTime(today.Year - 1, 12, 31);
                break;
        }
    }

    public void Dispose()
    {
        WalletSelectionState.OnWalletChanged -= _table.ReloadServerData;
        RecordEventService.OnRecordsChanged -= _table.ReloadServerData;
    }

}