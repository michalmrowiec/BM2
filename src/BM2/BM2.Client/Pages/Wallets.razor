@page "/wallets"
@using BM2.Shared.DTOs
@using BM2.Client.Components
@using BM2.Client.Services.API
@using BM2.Client.Services.Auth
@using Newtonsoft.Json

@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject IAuthService AuthService

<h3>Wallets</h3>

<MudButton @onclick="OpenAddWalletDialogAsync"
           Variant="Variant.Filled"
           Color="Color.Primary">
    Add wallet
</MudButton>

<MudDataGrid T="WalletDTO" Items="@WalletList">
    <Columns>
        <PropertyColumn Title="Name" Property="x => x.WalletName"/>
        <PropertyColumn Title="Is active" Property="x => x.IsActive">
            <CellTemplate>
                <IsActiveGridIcon IsActive="context.Item.IsActive"/>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Currency" Property="x => x.DefaultCurrency" SortBy="x => x.DefaultCurrency!.Name">
            <CellTemplate>
                @context.Item.DefaultCurrency?.ToString()
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn StickyRight="true">
            <CellTemplate>
                <MudIconButton @onclick="@(async () => await OpenUpdateWalletDialogAsync(context.Item))"
                               Icon="@Icons.Material.Outlined.Edit"
                               Size="@Size.Small"/>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IList<WalletDTO> WalletList { get; set; } = new List<WalletDTO>();

    private async Task GetWallets()
    {
        var response = await ApiClient.Get("api/v1/wallets");
        var r = await response.Content.ReadAsStringAsync();
        WalletList = JsonConvert.DeserializeObject<IList<WalletDTO>>(r) ?? [];
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (await AuthService.EnsureInitializedAsync())
        {
            await GetWallets();
        }
    }

    private Task OpenAddWalletDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var parameters = new DialogParameters<AddWalletDialogForm>
        {
            {
                x => x.FuncsOnCreated,
                [EventCallback.Factory.Create(this, GetWallets)]
            }
        };
        return DialogService.ShowAsync<AddWalletDialogForm>(null, parameters, options);
    }

    private Task OpenUpdateWalletDialogAsync(WalletDTO wallet)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var parameters = new DialogParameters<AddWalletDialogForm>
        {
            {
                x => x.FuncsOnCreated,
                [EventCallback.Factory.Create(this, GetWallets)]
            },
            {
                x => x.FormType, DialogFormType.Edit
            },
            {
                x => x.WalletToUpdate, wallet
            }
        };
        return DialogService.ShowAsync<AddWalletDialogForm>(null, parameters, options);
    }
}
