@inherits LayoutComponentBase
@* Created with the layout so it sees every navigation from the start. *@
@inject AppNavigation AppNavigation
@inject NavigationManager Navigation

<a class="skip-link" href="#main">@Tr("Skip to content")</a>

<header class="app-header">
    <div class="app-header__lead">
        @if (BackFallback is { } fallback)
        {
            <AuthorizeView>
                <Authorized>
                    <BackButton Fallback="@fallback" />
                </Authorized>
            </AuthorizeView>
        }
        <a class="app-brand" href="">BM<span class="app-brand__dot" aria-hidden="true"></span></a>
    </div>
    <div class="app-header__actions">
        <AuthorizeView>
            <Authorized>
                <WalletSwitcher />
                <BalancesToggle />
            </Authorized>
        </AuthorizeView>
        <ThemeToggle />
        <AuthorizeView>
            <NotAuthorized>
                <a class="btn btn-secondary btn-sm" href="Account/Login">@Tr("Log in")</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

<main id="main" class="app-main">
    @Body
</main>

<ToastHost />

<AuthorizeView>
    <Authorized>
        <BottomNav />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @Tr("An unhandled error has occurred.")
    <a href="." class="reload">@Tr("Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] TopLevel = ["", "records", "stats", "more"];

    // Editors and stats screens have their own way back; the main sections need none.
    private string? BackFallback
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return TopLevel.Contains(path) || path.Contains('/') || path.StartsWith("Account", StringComparison.Ordinal)
                ? null
                : "more";
        }
    }
}
