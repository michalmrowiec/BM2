@inherits LayoutComponentBase
@* Created with the layout so it sees every navigation from the start. *@
@inject AppNavigation AppNavigation

<a class="skip-link" href="#main">@Tr("Skip to content")</a>

<header class="app-header">
    <div class="app-header__lead">
        <a class="app-brand" href="">BM<span class="app-brand__dot" aria-hidden="true"></span></a>
        <AuthorizeView Roles="@BM2.Contracts.Common.Demo.Role">
            <a class="demo-badge" href="Account/Login" title="@Tr("Read-only demo. Log in or create your own account.")">@Tr("Demo")</a>
        </AuthorizeView>
    </div>
    <div class="app-header__actions">
        <AuthorizeView>
            <Authorized>
                <WalletSwitcher />
                <BalancesToggle />
            </Authorized>
        </AuthorizeView>
        <ThemeToggle />
        <AuthorizeView>
            <NotAuthorized>
                <a class="btn btn-secondary btn-sm" href="Account/Login">@Tr("Log in")</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

<main id="main" class="app-main">
    @Body
</main>

<ToastHost />

<AuthorizeView>
    <Authorized>
        <BottomNav />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @Tr("An unhandled error has occurred.")
    <a href="." class="reload">@Tr("Reload")</a>
    <span class="dismiss">🗙</span>
</div>

