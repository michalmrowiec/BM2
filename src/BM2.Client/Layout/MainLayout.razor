@inherits LayoutComponentBase
@* Created with the layout so it sees every navigation from the start. *@
@inject AppNavigation AppNavigation

<a class="skip-link" href="#main">Skip to content</a>

<header class="app-header">
    <a class="app-brand" href="">BM2<span class="app-brand__dot" aria-hidden="true"></span></a>
    <div class="app-header__actions">
        <AuthorizeView>
            <Authorized>
                <WalletSwitcher />
            </Authorized>
        </AuthorizeView>
        <ThemeToggle />
        <AuthorizeView>
            <NotAuthorized>
                <a class="btn btn-secondary btn-sm" href="Account/Login">Log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

<main id="main" class="app-main">
    @Body
</main>

<ToastHost />

<AuthorizeView>
    <Authorized>
        <BottomNav />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
