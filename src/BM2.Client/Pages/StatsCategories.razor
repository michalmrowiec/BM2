@page "/stats/categories"
@attribute [Authorize]
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Categories
@using BM2.Contracts.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject StatsState State

<StatsHeader Title="@Tr("By category")">@Tr("Tap a category to see its last 12 months, then a bar to see that month's records.")</StatsHeader>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <StatsFilters Wallet="Wallet" OnChanged="ReloadAsync">
        <SegmentedControl Label="@Tr("Record type")" Options="TypeOptions" Value="State.Type" ValueChanged="(RecordType t) => SetTypeAsync(t)" />
    </StatsFilters>
    <div class="stats-actions"><PinButton WalletId="Wallet.Id" Kind="BM2.Contracts.Stats.PinnedChartKind.Categories" View="PinView" /></div>

    @if (_totals is null)
    {
        <p class="muted">@Tr("Loading…")</p>
    }
    else if (Slices.Count == 0)
    {
        <EmptyState IconName="chart" Title="@(State.Type == RecordType.Income ? Tr("No income in this period") : Tr("No expenses in this period"))">@Tr("Try another period, account or currency.")</EmptyState>
    }
    else
    {
        var total = Slices.Where(s => !_hidden.Contains(s.CategoryId)).Sum(s => s.Total);
        var hiddenCount = Slices.Count(s => _hidden.Contains(s.CategoryId));
        <div class="stats-split">
            <Chart Class="chart--donut" Options="_donut" OnItemClick="SelectAsync"
                   Label="@(State.Type == RecordType.Income ? Tr("Income by category, {0:N2} {1} in total. The list shows every amount.", total, CurrencyLabel.Of(Currency)) : Tr("Expenses by category, {0:N2} {1} in total. The list shows every amount.", total, CurrencyLabel.Of(Currency)))" />
            <div>
                <p class="stats-hidden">
                    @if (hiddenCount > 0)
                    {
                        <span>@Tr("{0} left out of the chart and total", hiddenCount)</span>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetHidden">@Tr("Reset")</button>
                    }
                    else
                    {
                        <span class="muted">@Tr("Untick a color dot to leave that category out of the chart and total.")</span>
                    }
                </p>
                <CategoryTotalsList Items="Slices" Wallet="Wallet" Currency="@Currency" Swatches="true"
                                    SelectedId="_trendId" OnSelect="id => SelectAsync(id.ToString())"
                                    Hidden="_hidden" OnToggle="ToggleHidden" />
            </div>
        </div>
        <p class="stats-total">
            @(hiddenCount > 0 ? Tr("Total of the rest") : Tr("Total")) <Amount Value="StatsCharts.Signed(total, State.Type)" Currency="@Currency" />
        </p>
    }

    @if (_trendId is { } trendId && _trend is not null)
    {
        <section class="stats-trend card" aria-labelledby="stats-trend-title">
            <div class="stats-section__head">
                <h2 class="stats-trend__title" id="stats-trend-title">@Tr("{0} · last 12 months", StatsCharts.NameOf(Wallet, trendId))</h2>
                <span class="section-header__actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowPeriodRecords(trendId)">
                        <Icon Name="list" /> @Tr("Records")
                    </button>
                    <button type="button" class="icon-button" aria-label="@Tr("Close category trend")" @onclick="CloseTrend"><Icon Name="close" /></button>
                </span>
            </div>
            <Chart Options="_trendChart" OnItemClick="ShowBarRecords"
                   Label="@(State.Type == RecordType.Income ? Tr("Monthly income for {0}. Tap a bar for its records. The table lists every month.", StatsCharts.NameOf(Wallet, trendId)) : Tr("Monthly expenses for {0}. Tap a bar for its records. The table lists every month.", StatsCharts.NameOf(Wallet, trendId)))" />
            <MonthTable Items="_trend.Items" Currency="@Currency" Only="State.Type" />
        </section>
    }

    <RecordsPreview Wallet="Wallet" Query="_preview" Closed="() => _preview = null" />
}

@code {
    private (string, string) PinView()
    {
        var period = State.Period switch
        {
            StatsPeriod.Month => Tr("this month"),
            StatsPeriod.Year => Tr("this year"),
            _ => $"{State.From:d MMM} – {State.To:d MMM yyyy}",
        };
        var title = State.Type == RecordType.Income ? Tr("Income by category · {0}", period) : Tr("Expenses by category · {0}", period);
        return (title, PinnedChartQueries.Categories(State));
    }

    private IReadOnlyList<(RecordType, string)> TypeOptions =>
        [(RecordType.Expense, Tr("Expenses")), (RecordType.Income, Tr("Income"))];

    private WalletSnapshot? _loadedFor;
    private CategoryTotals? _totals;
    private Guid? _trendId;
    private MonthlyTotals? _trend;
    private object _donut = new();
    private object _trendChart = new();

    private WalletSnapshot? Wallet => WalletState.Current;

    private string Currency => State.Currency ?? "";

    private List<CategoryTotal> Slices => _totals?.Items.Where(i => i.Type == State.Type).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        if (_loadedFor?.Id != Wallet.Id)
        {
            _trendId = null;
            _hidden.Clear();
        }

        _loadedFor = Wallet;
        State.Use(Wallet);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Wallet is null || !State.IsValid)
        {
            return;
        }

        var (from, to) = State.Range;
        _totals = (await Api.GetAsync<CategoryTotals>(State.Url(Wallet.Id, "categories", from, to))).Value;
        BuildDonut();
        await LoadTrendAsync();
    }

    private async Task SetTypeAsync(RecordType type)
    {
        State.Type = type;
        BuildDonut();
        await LoadTrendAsync();
    }

    private async Task SelectAsync(string key)
    {
        if (Guid.TryParse(key, out var id))
        {
            _trendId = id;
            await LoadTrendAsync();
        }
    }

    private RecordsPreviewQuery? _preview;

    // The selected category in one month of the trend.
    private void ShowBarRecords(string key)
    {
        if (_trendId is { } id && StatsCharts.TryParseBar(key, out var type, out var month))
        {
            _preview = new RecordsPreviewQuery($"{StatsCharts.NameOf(Wallet!, id)} · {month:MMMM yyyy}", month, month.AddMonths(1),
                type, Currency, State.AccountId, id);
        }
    }

    // The selected category in the chosen period.
    private void ShowPeriodRecords(Guid id)
    {
        var (from, to) = State.Range;
        _preview = new RecordsPreviewQuery($"{StatsCharts.NameOf(Wallet!, id)} · {from:d MMM yyyy} – {to.AddDays(-1):d MMM yyyy}", from, to,
            State.Type, Currency, State.AccountId, id);
    }

    private void CloseTrend()
    {
        _trendId = null;
        _trend = null;
    }

    private async Task LoadTrendAsync()
    {
        // A category of the other type has no bars to show.
        var category = StatsCharts.CategoryOf(Wallet!, _trendId);
        if (_trendId is not { } id
            || category is not null && (category.Type == CategoryType.Income ? RecordType.Income : RecordType.Expense) != State.Type)
        {
            CloseTrend();
            return;
        }

        var (from, to) = State.TrendRange;
        _trend = (await Api.GetAsync<MonthlyTotals>(State.Url(Wallet!.Id, "monthly", from, to, categoryId: id))).Value;
        if (_trend is not null)
        {
            _trendChart = StatsCharts.Months(_trend.Items, State.Type);
        }
    }

    // Categories left out of the donut and total; kept for this screen only.
    private readonly HashSet<Guid?> _hidden = [];

    private void ToggleHidden(Guid? id)
    {
        if (!_hidden.Remove(id))
        {
            _hidden.Add(id);
        }

        BuildDonut();
    }

    private void ResetHidden()
    {
        _hidden.Clear();
        BuildDonut();
    }

    private void BuildDonut() => _donut = StatsCharts.Donut(
        Slices.Select(s => (s.CategoryId?.ToString() ?? "", StatsCharts.NameOf(Wallet!, s.CategoryId), s.Total)).ToList(),
        Currency, _hidden.Select(id => id?.ToString() ?? "").ToList());
}
