@page "/stats/monthly"
@attribute [Authorize]
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject StatsState State

<StatsHeader Title="Income vs expenses">Bars per month, with the net result as a line.</StatsHeader>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <StatsFilters Wallet="Wallet" Mode="StatsFilterMode.Months" OnChanged="ReloadAsync" />

    @if (_monthly is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        var income = _monthly.Items.Sum(m => m.Income);
        var expense = _monthly.Items.Sum(m => m.Expense);
        var months = _monthly.Items.Count;
        <dl class="stats-figures">
            <div><dt>Income</dt><dd><Amount Value="income" Currency="@Currency" /></dd></div>
            <div><dt>Expenses</dt><dd><Amount Value="-expense" Currency="@Currency" /></dd></div>
            <div><dt>Net</dt><dd><Amount Value="income - expense" Currency="@Currency" /></dd></div>
            <div><dt>Net per month</dt><dd><Amount Value="(income - expense) / months" Currency="@Currency" /></dd></div>
        </dl>
        <Chart Options="_chart" OnItemClick="ShowBarRecords"
               Label="Income, expenses and net per month for 12 months. Tap a bar for its records. The table lists every month." />
        <MonthTable Items="_monthly.Items" Currency="@Currency" />
    }

    <RecordsPreview Wallet="Wallet" Query="_preview" Closed="() => _preview = null" />
}

@code {
    private WalletSnapshot? _loadedFor;
    private MonthlyTotals? _monthly;
    private object _chart = new();
    private RecordsPreviewQuery? _preview;

    private void ShowBarRecords(string key)
    {
        if (StatsCharts.TryParseBar(key, out var type, out var month))
        {
            var noun = type == BM2.Contracts.Records.RecordType.Income ? "Income" : "Expenses";
            _preview = new RecordsPreviewQuery($"{noun} · {month:MMMM yyyy}", month, month.AddMonths(1), type, Currency, State.AccountId);
        }
    }

    private WalletSnapshot? Wallet => WalletState.Current;

    private string Currency => State.Currency ?? "";

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        _loadedFor = Wallet;
        State.Use(Wallet);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var (from, to) = StatsState.MonthsEndingWith(State.Anchor);
        _monthly = (await Api.GetAsync<MonthlyTotals>(State.Url(Wallet!.Id, "monthly", from, to))).Value;
        if (_monthly is not null)
        {
            _chart = StatsCharts.Months(_monthly.Items);
        }
    }
}
