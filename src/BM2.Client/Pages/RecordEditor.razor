@page "/records/new"
@page "/records/{Id:guid}"
@attribute [Authorize]
@using BM2.Client.Components.Records
@using BM2.Contracts.Records
@using BM2.Contracts.Recurring
@using BM2.Contracts.Templates
@using BM2.Contracts.Wallets
@using BM2.Client.Components.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject AppNavigation AppNavigation
@inject IJSRuntime JS

<PageTitle>@Title · BM2</PageTitle>

<section class="editor-sheet" aria-labelledby="editor-title">
    <header class="editor-sheet__header">
        <BackButton Fallback="records" Icon="close" Label="Close" />
        <h1 id="editor-title" class="editor-sheet__title" tabindex="-1">@Title</h1>
        <div class="editor-sheet__actions">
            @if (Id is not null && _record is not null && CanWriteRecord)
            {
                <a class="icon-button" href="@($"records/new?copy={Id}")" aria-label="Copy record"><Icon Name="copy" /></a>
                <button type="button" class="icon-button" aria-label="Delete record" @onclick="() => _confirmDelete = true">
                    <Icon Name="trash" />
                </button>
            }
        </div>
    </header>

    @if (Wallet is null)
    {
        <WalletPlaceholder />
    }
    else if (_loading)
    {
        <p aria-busy="true"><span class="skeleton skeleton--line"></span><span class="sr-only">Loading…</span></p>
    }
    else if (_missing)
    {
        <EmptyState IconName="list" Title="This record doesn't exist">It may have been deleted.</EmptyState>
    }
    else if ((_record is null || CopyId is not null) && !Wallet.Accounts.Any(a => a.CanWrite && !a.IsArchived))
    {
        <EmptyState IconName="bank" Title="You can't add records here">
            <ChildContent>Add an account first, or ask the wallet owner for edit access.</ChildContent>
            <Actions>
                @if (Wallet.Permissions.ManageAccounts)
                {
                    <a class="btn btn-primary" href="accounts">Add account</a>
                }
            </Actions>
        </EmptyState>
    }
    else if (Id is not null && !CanWriteRecord)
    {
        <EmptyState IconName="list" Title="View only">You can see this record but not change it.</EmptyState>
    }
    else
    {
        @if (Id is not null && _record?.RecurringRuleId is { } ruleId)
        {
            <div class="notice">
                <Icon Name="repeat" />
                <p>Added by a recurring rule. Changes here apply only to this record.</p>
                <a class="btn btn-secondary btn-sm" href="@($"recurring/{ruleId}")">Edit the rule</a>
            </div>
        }
        <RecordForm @ref="_form" @key="_formKey" Wallet="Wallet" Initial="_record" IsCopy="@(CopyId is not null && Id is null)"
                    Template="_template" Suggestions="_suggestions" DefaultAccountId="AccountId ?? _lastAccount" Busy="_busy" OnSubmit="SaveAsync"
                    OnSaveTemplate="SaveTemplateAsync" />
    }
</section>

<ConfirmDialog Open="_confirmDelete" OpenChanged="v => _confirmDelete = v" Title="Delete record?" ConfirmLabel="Delete"
               Danger="true" OnConfirm="DeleteAsync">
    <p>This can't be undone.</p>
    @if (_record is { PairWalletId: { } pairWallet, PairPending: false })
    {
        <label class="check">
            <input type="checkbox" checked="@_deletePair" @onchange="e => _deletePair = e.Value is true" />
            <span>Also delete the linked record in @(WalletState.Wallets.FirstOrDefault(w => w.Id == pairWallet)?.Name ?? "the other wallet")</span>
        </label>
    }
</ConfirmDialog>

@code {
    private RecordForm? _form;
    private RecordItem? _record;
    private bool _deletePair = true;
    private TemplateItem? _template;
    private RecordSuggestions? _suggestions;
    private Guid? _lastAccount;
    private string _formKey = "";
    private bool _loading = true;
    private bool _missing;
    private bool _busy;
    private bool _confirmDelete;

    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "copy")] public Guid? CopyId { get; set; }

    [SupplyParameterFromQuery(Name = "template")] public Guid? TemplateId { get; set; }

    /// <summary>The account a new record starts on, e.g. when added from that account's records.</summary>
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountId { get; set; }

    private WalletSnapshot? Wallet => WalletState.Current;

    private string Title => Id is not null ? "Edit record" : CopyId is not null ? "Copy record" : "New record";

    private bool CanWriteRecord => _record is not null && Wallet is not null
        && CanWrite(_record.AccountId) && (_record.TransferAccountId is not { } target || CanWrite(target));

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private bool CanWrite(Guid accountId) => Wallet!.Accounts.Any(a => a.Id == accountId && a.CanWrite);

    private async Task LoadAsync()
    {
        if (Wallet is null)
        {
            return;
        }

        _loading = true;
        _missing = false;
        _record = null;
        _template = null;
        var suggestions = WalletState.GetSuggestionsAsync();
        if ((Id ?? CopyId) is { } sourceId)
        {
            var result = await Api.GetAsync<RecordItem>($"api/wallets/{Wallet.Id}/records/{sourceId}");
            _record = result.Value;
            _missing = !result.Ok;
        }
        else if (TemplateId is { } templateId)
        {
            var templates = await Api.GetAsync<List<TemplateItem>>($"api/wallets/{Wallet.Id}/templates");
            _template = templates.Value?.Find(t => t.Id == templateId);
        }

        _suggestions = await suggestions;
        _lastAccount = await WalletState.GetLastAccountAsync();
        _formKey = $"{Wallet.Id}/{Id}/{CopyId}/{TemplateId}/{AccountId}";
        _loading = false;
    }

    private async Task SaveAsync(SaveRecordRequest request)
    {
        _busy = true;
        var url = $"api/wallets/{Wallet!.Id}/records";
        var created = Id is null ? await Api.PostAsync<RecordItem>(url, request) : null;
        var result = created ?? await Api.PutAsync($"{url}/{Id}", request);

        // Repeat: the new record is the first occurrence and the rule continues after it.
        if (created?.Value is { } record && _form?.BuildRuleRequest(record.Id) is { } rule)
        {
            var saved = await Api.PostAsync<RecurringRuleItem>($"api/wallets/{Wallet.Id}/recurring", rule);
            if (!saved.Ok)
            {
                Toasts.Show(saved.Problem!.Detail ?? "The record is saved, but the repeat couldn't be.", ToastKind.Error);
            }
        }

        _busy = false;

        if (result.Ok)
        {
            await WalletState.SetLastAccountAsync(request.AccountId);
            WalletState.ForgetSuggestions();
            Toasts.Show("Saved.", ToastKind.Success);
            await WalletState.RefreshAsync();
            await GoBackAsync();
        }
        else if (result.Problem!.HasFieldErrors)
        {
            _form?.ShowServerErrors(result.Problem);
        }
        else if (result.Problem.IsNotFoundOrForbidden)
        {
            Toasts.Show("You can't save this record here.", ToastKind.Error);
        }
        else
        {
            Toasts.ShowError();
        }
    }

    private async Task SaveTemplateAsync(SaveTemplateRequest request)
    {
        var result = await Api.PostAsync<TemplateItem>($"api/wallets/{Wallet!.Id}/templates", request);
        if (result.Ok)
        {
            Toasts.Show("Saved as template. It's pinned on Home.", ToastKind.Success);
        }
        else
        {
            Toasts.Show(result.Problem!.Detail ?? "Couldn't save the template.", ToastKind.Error);
        }
    }

    // "Save and go back" (spec): to the previous app page, or to Records when the editor was opened directly.
    private async Task GoBackAsync()
    {
        if (AppNavigation.CanGoBack)
        {
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo("records");
        }
    }

    private async Task DeleteAsync()
    {
        var result = await Api.DeleteAsync($"api/wallets/{Wallet!.Id}/records/{Id}{(_deletePair ? "?pair=true" : null)}");
        _confirmDelete = false;
        if (result.Ok)
        {
            WalletState.ForgetSuggestions();
            Toasts.Show("Record deleted.");
            await WalletState.RefreshAsync();
            await GoBackAsync();
        }
        else
        {
            Toasts.ShowError();
        }
    }
}
