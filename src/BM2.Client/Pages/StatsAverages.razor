@page "/stats/averages"
@attribute [Authorize]
@using System.Globalization
@using BM2.Client.Components.Records
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject StatsState State

<StatsHeader Title="@Tr("Category averages")">@Tr("Total and monthly average per category over the months you tick.")</StatsHeader>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <StatsFilters Wallet="Wallet" Mode="StatsFilterMode.Year" OnChanged="ReloadAsync">
        <SegmentedControl Label="@Tr("Record type")" Options="TypeOptions" Value="State.Type" ValueChanged="(RecordType t) => State.Type = t" />
        @if (Available.Count > 0)
        {
            <div class="field">
                <span class="field__label" id="average-months">@Tr("Months counted")</span>
                <ChipGroup TValue="int" Label="@Tr("Months counted")" Options="Available" Multiple="true" Selected="Selected" DescribedBy="average-months-hint"
                           SelectedChanged="months => State.AverageMonths = months.ToList()" Class="stats-months" />
                <span class="field__hint" id="average-months-hint">
                    @Tr("Average = total of the ticked months ÷ {0}. Ticked months without records count as zero.", Selected.Count)
                </span>
            </div>
        }
    </StatsFilters>

    @if (Available.Count == 0)
    {
        <EmptyState IconName="coins" Title="@Tr("This year has not started yet")">@Tr("Pick the current or a past year.")</EmptyState>
    }
    else if (_data is null)
    {
        <p class="muted">@Tr("Loading…")</p>
    }
    else if (Selected.Count == 0)
    {
        <p class="muted">@Tr("Tick at least one month.")</p>
    }
    else if (Rows.Count == 0)
    {
        <EmptyState IconName="coins" Title="@NoRowsTitle">@Tr("Try other months, an account or a currency.")</EmptyState>
    }
    else
    {
        var total = Rows.Sum(r => r.Total);
        <dl class="stats-figures">
            <div><dt>@Tr("Total")</dt><dd><Amount Value="StatsCharts.Signed(total, State.Type)" Currency="@Currency" /></dd></div>
            <div><dt>@Tr("Average per month")</dt><dd><Amount Value="StatsCharts.Signed(total / Selected.Count, State.Type)" Currency="@Currency" /></dd></div>
        </dl>
        <ul class="stats-list">
            @foreach (var row in Rows)
            {
                <li @key="row.CategoryId">
                    <ListRow Title="@StatsCharts.NameOf(Wallet, row.CategoryId)"
                             Subtitle="@Tr("Total {0} {1} · {2}", StatsCharts.Signed(row.Total, State.Type).ToString("N2", CultureInfo.CurrentCulture), CurrencyLabel.Of(Currency), StatsCharts.Share(row.Total, total))">
                        <Leading><RecordAvatar Category="StatsCharts.CategoryOf(Wallet, row.CategoryId)" Type="State.Type" Fallback="?" /></Leading>
                        <Trailing>
                            <span class="stats-average">
                                <Amount Value="StatsCharts.Signed(row.Total / Selected.Count, State.Type)" Currency="@Currency" />
                                <span class="muted">@Tr("per month")</span>
                            </span>
                        </Trailing>
                    </ListRow>
                </li>
            }
        </ul>
    }
}

@code {
    private IReadOnlyList<(RecordType, string)> TypeOptions =>
        [(RecordType.Expense, Tr("Expenses")), (RecordType.Income, Tr("Income"))];

    private WalletSnapshot? _loadedFor;
    private CategoryMonthTotals? _data;

    private WalletSnapshot? Wallet => WalletState.Current;

    private string Currency => State.Currency ?? "";

    private string NoRowsTitle => State.Type == RecordType.Income ? Tr("No income in these months") : Tr("No expenses in these months");

    private int Year => State.Anchor.Year;

    // Months of the year up to the current one.
    private IReadOnlyList<(int, string)> Available
    {
        get
        {
            var today = DateTime.Now;
            var last = Year < today.Year ? 12 : Year == today.Year ? today.Month : 0;
            return Enumerable.Range(1, last)
                .Select(m => (m, CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m)))
                .ToList();
        }
    }

    private IReadOnlyCollection<int> Selected => State.AverageMonths ?? Available.Select(m => m.Item1).ToList();

    private List<(Guid? CategoryId, decimal Total)> Rows => _data is null
        ? []
        : _data.Items
            .Where(i => i.Type == State.Type && Selected.Contains(i.Month.Month))
            .GroupBy(i => i.CategoryId)
            .Select(g => (g.Key, g.Sum(i => i.Total)))
            .Where(r => r.Item2 != 0)
            .OrderByDescending(r => r.Item2)
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        _loadedFor = Wallet;
        State.Use(Wallet);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var from = new DateOnly(Year, 1, 1);
        _data = (await Api.GetAsync<CategoryMonthTotals>(State.Url(Wallet!.Id, "category-months", from, from.AddYears(1)))).Value;
    }
}
