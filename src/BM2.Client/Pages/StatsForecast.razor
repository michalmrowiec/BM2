@page "/stats/forecast"
@attribute [Authorize]
@using System.Globalization
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject StatsState State

<StatsHeader Title="Forecast">Where the balance is heading, from what is already scheduled.</StatsHeader>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <EditForm Model="State" class="stats-filters card">
        <SegmentedControl Label="Forecast length" Options="MonthOptions" Value="State.ForecastMonths" ValueChanged="(int m) => SetAsync(() => State.ForecastMonths = m)" />
        <SegmentedControl Label="Points" Options="StepOptions" Value="State.ForecastStep" ValueChanged="(ForecastStep s) => SetAsync(() => State.ForecastStep = s)" />
        @if (Currencies.Count > 1)
        {
            <SelectField Label="Currency" Options="Currencies" @bind-Value="State.Currency" @bind-Value:after="ReloadAsync"
                         Hint="Only accounts in this currency are counted." />
        }
        <label class="check">
            <input type="checkbox" checked="@State.ForecastAverages" @onchange="e => SetAsync(() => State.ForecastAverages = e.Value is true)" />
            <span>Include everyday spending – the average of the last 3 months from categories without recurring expenses, spread evenly</span>
        </label>
    </EditForm>

    @if (_data is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        var change = _data.End - _data.Start;
        <dl class="stats-figures">
            <div><dt>Today</dt><dd><Amount Value="_data.Start" Currency="@_data.Currency" /></dd></div>
            <div><dt>On @Day(_data.Points[^1].Date)</dt><dd><Amount Value="_data.End" Currency="@_data.Currency" /></dd></div>
            <div><dt>Lowest, @Day(_data.Lowest.Date)</dt><dd><Amount Value="_data.Lowest.Balance" Currency="@_data.Currency" /></dd></div>
            <div><dt>Change</dt><dd><Amount Value="change" Currency="@_data.Currency" /></dd></div>
        </dl>
        <Chart Options="_chart" Label="@($"Forecast balance until {Day(_data.Points[^1].Date)}. The figures above and the list below give the numbers.")" />
        <p class="muted">@Explanation</p>

        <div class="stats-actions">
            <PinButton WalletId="Wallet.Id" Kind="PinnedChartKind.Forecast" View="PinView" />
        </div>

        @if (_data.Items.Count > 0)
        {
            <h2 class="section-title">Biggest items</h2>
            <ul class="stats-list">
                @foreach (var item in _data.Items)
                {
                    <li>
                        <ListRow Title="@item.Label" Subtitle="@Describe(item)">
                            <Trailing><Amount Value="item.Amount" Currency="@_data.Currency" /></Trailing>
                        </ListRow>
                    </li>
                }
            </ul>
        }
    }
}

@code {
    private static readonly IReadOnlyList<(int, string)> MonthOptions = [(3, "3 months"), (6, "6 months"), (12, "12 months")];
    private static readonly IReadOnlyList<(ForecastStep, string)> StepOptions = [(ForecastStep.Day, "Daily"), (ForecastStep.Week, "Weekly")];

    private WalletSnapshot? _loadedFor;
    private ForecastData? _data;
    private object _chart = new();

    private WalletSnapshot? Wallet => WalletState.Current;

    private IReadOnlyList<(string?, string)> Currencies =>
        Wallet!.Accounts.Select(a => a.Currency).Append(Wallet.BaseCurrency).Distinct().Order().Select(c => ((string?)c, c)).ToList();

    private static string Day(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private static string Money(decimal value, string currency) => $"{value.ToString("N2", CultureInfo.CurrentCulture)} {currency}";

    private (string, string) PinView() =>
        ($"Forecast · {State.ForecastMonths} months · {State.Currency}", PinnedChartQueries.Forecast(State));

    private static string Describe(ForecastItem item)
    {
        var source = item.Source switch
        {
            ForecastSource.Recurring => item.Count == 1 ? "Recurring, once" : $"Recurring, {item.Count} times",
            ForecastSource.Planned => "Planned",
            ForecastSource.Pending => "To confirm",
            _ => "Dated ahead",
        };
        return $"{source} · from {item.FirstDate.ToString("d MMM", CultureInfo.CurrentCulture)}";
    }

    private string Explanation
    {
        get
        {
            var d = _data!;
            var accounts = d.AccountCount == 1 ? "1 account" : $"{d.AccountCount} accounts";
            var text = $"Starts from today's balance of {Money(d.Start, d.Currency)} on {accounts} in {d.Currency}. "
                + $"It adds the coming occurrences of {d.RecurringCount} recurring {(d.RecurringCount == 1 ? "rule" : "rules")} "
                + $"and {d.RecordCount} planned, pending or future-dated {(d.RecordCount == 1 ? "record" : "records")}. ";
            text += State.ForecastAverages && d.DailyAverage > 0
                ? $"Everyday spending is estimated at {Money(d.DailyAverage, d.Currency)} a day – the average from "
                    + $"{d.AverageFrom.ToString("MMMM", CultureInfo.CurrentCulture)} to {d.AverageFrom.AddMonths(2).ToString("MMMM", CultureInfo.CurrentCulture)} "
                    + $"in {d.AveragedCategoryCount} {(d.AveragedCategoryCount == 1 ? "category" : "categories")} that have no recurring expense. "
                : "Everyday spending is not included, so only known items move the line. ";
            return text + "It is an estimate: anything not recorded or scheduled is not in it.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        _loadedFor = Wallet;
        State.Use(Wallet);
        await ReloadAsync();
    }

    private Task SetAsync(Action change)
    {
        change();
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var query = new ForecastQuery
        {
            Currency = State.Currency,
            Months = State.ForecastMonths,
            Step = State.ForecastStep,
            Averages = State.ForecastAverages,
            Today = DateOnly.FromDateTime(DateTime.Now),
        };
        _data = (await Api.GetAsync<ForecastData>($"api/wallets/{Wallet!.Id}/stats/forecast" + query.ToQueryString())).Value;
        if (_data is not null)
        {
            _chart = StatsCharts.Forecast(_data.Points);
        }
    }
}
