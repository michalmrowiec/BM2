@page "/stats/forecast"
@attribute [Authorize]
@using System.Globalization
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject StatsState State

<StatsHeader Title="@Tr("Forecast")">@Tr("Where the balance is heading, from what is already scheduled.")</StatsHeader>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <EditForm Model="State" class="stats-filters card">
        <SegmentedControl Label="@Tr("Forecast length")" Options="MonthOptions" Value="State.ForecastMonths" ValueChanged="(int m) => SetAsync(() => State.ForecastMonths = m)" />
        <SegmentedControl Label="@Tr("Points")" Options="StepOptions" Value="State.ForecastStep" ValueChanged="(ForecastStep s) => SetAsync(() => State.ForecastStep = s)" />
        @if (Currencies.Count > 1)
        {
            <SelectField Label="@Tr("Currency")" Options="Currencies" @bind-Value="State.Currency" @bind-Value:after="ReloadAsync"
                         Hint="@Tr("Only accounts in this currency are counted.")" />
        }
        <label class="check">
            <input type="checkbox" checked="@State.ForecastAverages" @onchange="e => SetAsync(() => State.ForecastAverages = e.Value is true)" />
            <span>@Tr("Include everyday spending – the average of the last 3 months from categories without recurring expenses, spread evenly")</span>
        </label>
    </EditForm>

    @if (_data is null)
    {
        <p class="muted">@Tr("Loading…")</p>
    }
    else
    {
        var change = _data.End - _data.Start;
        <dl class="stats-figures">
            <div><dt>@Tr("Today")</dt><dd><Amount Value="_data.Start" Currency="@_data.Currency" /></dd></div>
            <div><dt>@Tr("On {0}", Day(_data.Points[^1].Date))</dt><dd><Amount Value="_data.End" Currency="@_data.Currency" /></dd></div>
            <div><dt>@Tr("Lowest, {0}", Day(_data.Lowest.Date))</dt><dd><Amount Value="_data.Lowest.Balance" Currency="@_data.Currency" /></dd></div>
            <div><dt>@Tr("Change")</dt><dd><Amount Value="change" Currency="@_data.Currency" /></dd></div>
        </dl>
        <Chart Options="_chart" Label="@Tr("Forecast balance until {0}. The figures above and the list below give the numbers.", Day(_data.Points[^1].Date))" />
        <p class="muted">@Explanation</p>

        <div class="stats-actions">
            <PinButton WalletId="Wallet.Id" Kind="PinnedChartKind.Forecast" View="PinView" />
        </div>

        @if (_data.Items.Count > 0)
        {
            <h2 class="section-title">@Tr("Biggest items")</h2>
            <ul class="stats-list">
                @foreach (var item in _data.Items)
                {
                    <li>
                        <ListRow Title="@item.Label" Subtitle="@Describe(item)">
                            <Trailing><Amount Value="item.Amount" Currency="@_data.Currency" /></Trailing>
                        </ListRow>
                    </li>
                }
            </ul>
        }
    }
}

@code {
    private IReadOnlyList<(int, string)> MonthOptions =>
        [(3, Tr("{0} months", 3)), (6, Tr("{0} months", 6)), (12, Tr("{0} months", 12))];
    private IReadOnlyList<(ForecastStep, string)> StepOptions => [(ForecastStep.Day, Tr("Daily")), (ForecastStep.Week, Tr("Weekly"))];

    private WalletSnapshot? _loadedFor;
    private ForecastData? _data;
    private object _chart = new();

    private WalletSnapshot? Wallet => WalletState.Current;

    private IReadOnlyList<(string?, string)> Currencies =>
        Wallet!.Accounts.Select(a => a.Currency).Append(Wallet.BaseCurrency).Distinct().Order().Select(c => ((string?)c, c)).ToList();

    private static string Day(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private static string Money(decimal value, string currency) => $"{value.ToString("N2", CultureInfo.CurrentCulture)} {currency}";

    private (string, string) PinView() =>
        (Tr("Forecast · {0} months · {1}", State.ForecastMonths, State.Currency), PinnedChartQueries.Forecast(State));

    private static string Describe(ForecastItem item)
    {
        var source = item.Source switch
        {
            ForecastSource.Recurring => Plural(item.Count, "Recurring, {0} time", "Recurring, {0} times"),
            ForecastSource.Planned => Tr("Planned"),
            ForecastSource.Pending => Tr("To confirm"),
            _ => Tr("Dated ahead"),
        };
        return Tr("{0} · from {1}", source, item.FirstDate.ToString("d MMM", CultureInfo.CurrentCulture));
    }

    private string Explanation
    {
        get
        {
            var d = _data!;
            var text = Tr("Starts from today's balance of {0} on {1} in {2}. ", Money(d.Start, d.Currency),
                    Plural(d.AccountCount, "{0} account", "{0} accounts"), d.Currency)
                + Tr("It adds the coming occurrences of {0} and {1}. ",
                    Plural(d.RecurringCount, "{0} recurring rule", "{0} recurring rules"),
                    Plural(d.RecordCount, "{0} planned, pending or future-dated record", "{0} planned, pending or future-dated records"));
            text += State.ForecastAverages && d.DailyAverage > 0
                ? Tr("Everyday spending is estimated at {0} a day – the average from {1} to {2} in {3} that have no recurring expense. ",
                    Money(d.DailyAverage, d.Currency),
                    d.AverageFrom.ToString("MMMM", CultureInfo.CurrentCulture),
                    d.AverageFrom.AddMonths(2).ToString("MMMM", CultureInfo.CurrentCulture),
                    Plural(d.AveragedCategoryCount, "{0} category", "{0} categories"))
                : Tr("Everyday spending is not included, so only known items move the line. ");
            return text + Tr("It is an estimate: anything not recorded or scheduled is not in it.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        _loadedFor = Wallet;
        State.Use(Wallet);
        await ReloadAsync();
    }

    private Task SetAsync(Action change)
    {
        change();
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var query = new ForecastQuery
        {
            Currency = State.Currency,
            Months = State.ForecastMonths,
            Step = State.ForecastStep,
            Averages = State.ForecastAverages,
            Today = DateOnly.FromDateTime(DateTime.Now),
        };
        _data = (await Api.GetAsync<ForecastData>($"api/wallets/{Wallet!.Id}/stats/forecast" + query.ToQueryString())).Value;
        if (_data is not null)
        {
            _chart = StatsCharts.Forecast(_data.Points);
        }
    }
}
