@page "/"

<PageTitle>BM2</PageTitle>

<h1>BM2</h1>

<AuthorizeView>
    <Authorized>
        @* Data comes from the API only once WebAssembly runs; prerendering shows the placeholder. *@
        @if (RendererInfo.IsInteractive)
        {
            <MeGreeting />
        }
        else
        {
            <p>Loading…</p>
        }
    </Authorized>
    <NotAuthorized>
        <p><a href="Account/Login">Log in</a></p>
    </NotAuthorized>
</AuthorizeView>
