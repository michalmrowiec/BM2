@page "/"
@using BM2.Contracts.Accounts
@using BM2.Client.Components.Accounts
@using BM2.Client.Components.Budgets
@using BM2.Client.Components.Records
@using BM2.Contracts.Budgets
@using BM2.Contracts.Dashboard
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Records
@using BM2.Contracts.Recurring
@using BM2.Contracts.Stats
@using BM2.Client.Components.Stats
@using BM2.Contracts.Templates
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>BM2</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!WalletState.IsLoaded)
        {
            <p aria-busy="true"><span class="skeleton skeleton--line"></span><span class="sr-only">@Tr("Loading…")</span></p>
        }
        else if (WalletState.Wallets.Count == 0)
        {
            <section class="onboarding">
                <p class="eyebrow">@Tr("Welcome to BM2")</p>
                <h1 class="page-title">@Tr("Start with a wallet")</h1>
                <p class="lead">@Tr("A wallet holds your accounts and records. You can share it with family later.")</p>
                <div class="card">
                    <WalletForm OnSaved="WalletState.SelectAsync" />
                </div>
            </section>
        }
        else if (WalletState.Current is { } wallet)
        {
            <h1 class="page-title">@wallet.Name</h1>

            var active = wallet.Accounts.Where(a => !a.IsArchived).ToList();
            var counted = active.Where(a => !a.ExcludeFromTotal).ToList();
            var accounts = active.Where(a => a.Kind == AccountKind.Cash && a.ShowOnDashboard).ToList();
            var investments = active.Where(a => a.Kind == AccountKind.Investment && a.ShowOnDashboard).ToList();
            if (active.Count > 0)
            {
                <section class="balance" aria-label="@Tr("Total balance")">
                    @* Whole wallet: cash balances plus investment values; the forecast stays cash only. *@
                    @foreach (var total in counted.GroupBy(a => a.Currency).Select(g => (
                                  Currency: g.Key,
                                  Cash: g.Where(a => a.Kind == AccountKind.Cash).Sum(a => a.Balance),
                                  Invested: g.Where(a => a.Kind == AccountKind.Investment).Sum(a => a.Valuation ?? a.Balance),
                                  HasInvestments: g.Any(a => a.Kind == AccountKind.Investment),
                                  Sum: g.Sum(a => a.Valuation ?? a.Balance),
                                  WithPlanned: g.Sum(a => a.Kind == AccountKind.Cash ? a.WithPlanned : a.Valuation ?? a.Balance))))
                    {
                        <Amount Value="total.Sum" Currency="@total.Currency" Large="true"
                                Sign="@(total.Sum < 0 ? AmountSign.Minus : AmountSign.None)" />
                        @if (total.HasInvestments)
                        {
                            <span class="balance__planned balance__split">
                                <span>@Tr("Cash") <Amount Value="total.Cash" Currency="@total.Currency" Sign="@(total.Cash < 0 ? AmountSign.Minus : AmountSign.None)" /></span>
                                <span>@Tr("Investments") <Amount Value="total.Invested" Currency="@total.Currency" Sign="@(total.Invested < 0 ? AmountSign.Minus : AmountSign.None)" /></span>
                            </span>
                        }
                        @if (total.WithPlanned != total.Sum)
                        {
                            <span class="balance__planned">
                                @Tr("With planned:")
                                <Amount Value="total.WithPlanned" Currency="@total.Currency"
                                        Sign="@(total.WithPlanned < 0 ? AmountSign.Minus : AmountSign.None)" />
                            </span>
                        }
                    }
                </section>

                @* Right under the balance: the quickest way to add a common record. *@
                @if (_templates.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Quick add")</h2>
                        <a class="link" href="templates">@Tr("Templates")</a>
                    </div>
                    <ul class="template-bar">
                        @foreach (var template in _templates)
                        {
                            <li>
                                <a class="template-tile" href="@($"records/new?template={template.Id}")">
                                    <RecordAvatar Category="TemplateText.CategoryOf(template, wallet)" Type="template.Type"
                                                  Fallback="@TemplateText.Label(template, wallet)" />
                                    <span class="template-tile__label">@TemplateText.Label(template, wallet)</span>
                                    @if (template.Amount is { } amount)
                                    {
                                        <Amount Value="amount" Currency="@TemplateText.Currency(template, wallet)" Sign="TemplateText.Sign(template.Type)" />
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }

                <ul class="account-cards stagger">
                    @foreach (var account in accounts)
                    {
                        <li>
                            <a class="account-card" href="@($"records?accountId={account.Id}&all=true")">
                                <span class="account-card__name">@account.Name</span>
                                <Amount Value="account.Balance" Currency="@account.Currency" />
                            </a>
                        </li>
                    }
                </ul>

                @if (investments.Count > 0)
                {
                    <h2 class="section-title">@Tr("Investments")</h2>
                    <ul class="account-cards">
                        @foreach (var account in investments)
                        {
                            var value = account.Valuation ?? account.Balance;
                            <li>
                                <button type="button" class="account-card" @onclick="() => _valuing = account.Id">
                                    <span class="account-card__name">@account.Name</span>
                                    <Amount Value="value" Currency="@account.Currency" Sign="@(value < 0 ? AmountSign.Minus : AmountSign.None)" />
                                    <span class="account-card__meta">
                                        @Tr("Gain") <Amount Value="Math.Abs(value - account.Balance)" Currency="@account.Currency"
                                                     Sign="@(value < account.Balance ? AmountSign.Minus : AmountSign.Plus)" />
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                    <ValuationSheet WalletId="wallet.Id" Account="@investments.FirstOrDefault(a => a.Id == _valuing)"
                                    Open="_valuing is not null" OpenChanged="v => { if (!v) _valuing = null; }" OnChanged="WalletState.RefreshAsync" />
                }

                @if (_month?.Totals.Count > 0)
                {
                    <h2 class="section-title">@DateTime.Now.ToString("MMMM")</h2>
                    <div class="month-stats month-stats--three">
                        @foreach (var total in _month.Totals)
                        {
                            <a class="stat" href="records?type=Income">
                                <span class="stat__label">@Tr("Income")</span>
                                <Amount Value="total.Income" Currency="@total.Currency" Sign="AmountSign.Plus" />
                            </a>
                            <a class="stat" href="records?type=Expense">
                                <span class="stat__label">@Tr("Expenses")</span>
                                <Amount Value="total.Expense" Currency="@total.Currency" Sign="AmountSign.Minus" />
                            </a>
                            <a class="stat" href="records">
                                <span class="stat__label">@Tr("Balance")</span>
                                <Amount Value="total.Income - total.Expense" Currency="@total.Currency" />
                            </a>
                        }
                    </div>
                }

                @if (_pending.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("To confirm")</h2>
                        <span class="section-header__actions">
                            @if (_pending.Count > 1)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => _confirmAll = true">
                                    <Icon Name="check" /> @Tr("Confirm all")
                                </button>
                            }
                            <a class="link" href="records?status=Pending&all=true">@Tr("All")</a>
                        </span>
                    </div>
                    <RecordList Items="_pending" Wallet="wallet" />
                }

                @if (_planned.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Planned")</h2>
                        <span class="section-header__actions">
                            @if (_planned.Count > 1)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => _choiceAll = true">
                                    <Icon Name="check" /> @Tr("Confirm all")
                                </button>
                            }
                            <a class="link" href="records?status=Planned&all=true">@Tr("All")</a>
                        </span>
                    </div>
                    <RecordList Items="_planned" Wallet="wallet" />
                }

                @if (_budgets is { Items.Count: > 0 } budgets)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Budgets")</h2>
                        <a class="link" href="budgets">@Tr("All budgets")</a>
                    </div>
                    <ul class="budget-list">
                        @foreach (var item in BudgetBar.ByUsage(budgets.Items).Take(4))
                        {
                            <li @key="item.Id">
                                <a class="budget-list__button" href="budgets">
                                    <BudgetBar Item="item" Currency="@budgets.Currency"
                                               Category="wallet.Categories.FirstOrDefault(c => c.Id == item.CategoryId)" />
                                </a>
                            </li>
                        }
                    </ul>
                }

                @if (_pins.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Pinned charts")</h2>
                        <a class="link" href="stats">@Tr("Stats")</a>
                    </div>
                    <div class="pinned-charts">
                        @foreach (var pin in _pins)
                        {
                            <PinnedChartCard @key="pin.Id" Wallet="wallet" Pin="pin" OnUnpin="UnpinAsync" />
                        }
                    </div>
                }

                @if (_upcoming.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Upcoming")</h2>
                        <a class="link" href="recurring">@Tr("Recurring")</a>
                    </div>
                    <ul class="list">
                        @foreach (var (rule, index, date) in _upcoming)
                        {
                            var name = rule.Record.Name is { } n ? n + rule.Schedule.Suffix(index) : null;
                            var label = name ?? wallet.Categories.FirstOrDefault(c => c.Id == rule.Record.CategoryId)?.Name ?? Tr(rule.Record.Type.ToString());
                            <li @key="(rule.Id, index)">
                                <ListRow Title="@label" Subtitle="@date.ToString("dddd, d MMM")" OnClick="() => _occurrence = _occurrenceShown = (rule, label, date)">
                                    <Leading>
                                        <RecordAvatar Category="wallet.Categories.FirstOrDefault(c => c.Id == rule.Record.CategoryId)" Type="rule.Record.Type"
                                                      Fallback="@label" />
                                    </Leading>
                                    <Trailing>
                                        <Amount Value="rule.Record.Amount" Currency="@rule.Record.Currency" Sign="TemplateText.Sign(rule.Record.Type)" />
                                    </Trailing>
                                </ListRow>
                            </li>
                        }
                    </ul>
                }

                @if (_recent.Count > 0)
                {
                    <div class="section-header">
                        <h2 class="section-title">@Tr("Recent")</h2>
                        <a class="link" href="records">@Tr("All records")</a>
                    </div>
                    <RecordList Items="_recent" Wallet="wallet" />
                }
            }
            else
            {
                <EmptyState IconName="wallet" Title="@Tr("Add your first account")">
                    <ChildContent>@Tr("Accounts are where your money lives: cash, a bank account, savings.")</ChildContent>
                    <Actions>
                        @if (wallet.Permissions.ManageAccounts)
                        {
                            <a class="btn btn-primary" href="accounts">@Tr("Add account")</a>
                        }
                    </Actions>
                </EmptyState>
            }
        }
        else
        {
            <EmptyState IconName="wallet" Title="@Tr("Couldn't load your wallet")">
                <ChildContent>@Tr("Check your connection and try again.")</ChildContent>
                <Actions>
                    <button type="button" class="btn btn-secondary" @onclick="WalletState.RefreshAsync">@Tr("Try again")</button>
                </Actions>
            </EmptyState>
        }
    </Authorized>
    <NotAuthorized>
        <section class="hero">
            <p class="eyebrow">@Tr("Personal finance")</p>
            <h1 class="display">@Tr("Your money,") <span class="accent">@Tr("in ink.")</span></h1>
            <p class="lead">@Tr("A calm, fast ledger for everyday spending, shared wallets and what's coming next.")</p>
            <a class="btn btn-primary" href="Account/Login">@Tr("Log in")</a>
        </section>
    </NotAuthorized>
</AuthorizeView>

<ConfirmDialog Open="_confirmAll" OpenChanged="v => _confirmAll = v" Title="@Plural(_pending.Count, "Confirm {0} record?", "Confirm {0} records?")"
               ConfirmLabel="@Tr("Confirm all")" OnConfirm="ConfirmAllAsync">
    <p>@Tr("The records shown in To confirm are marked as checked (Completed). They already count in balances, so totals stay the same.")</p>
</ConfirmDialog>

@* An upcoming occurrence isn't a record yet: details of the rule's next record, then the rule itself. *@
<Sheet Open="_occurrence is not null" OpenChanged="v => { if (!v) _occurrence = null; }" Title="@(_occurrenceShown?.Label ?? "")">
    @if (_occurrenceShown is { } occurrence && WalletState.Current is { } w)
    {
        var (rule, _, date) = occurrence;
        var r = rule.Record;
        <div class="record-details">
            <div class="record-details__amount">
                <Amount Value="r.Amount" Currency="@r.Currency" Sign="TemplateText.Sign(r.Type)" />
            </div>
            <dl class="record-details__list">
                <div><dt>@Tr("Date")</dt><dd>@date.ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</dd></div>
                <div><dt>@Tr("Repeats")</dt><dd>@RecurringText.Describe(rule.Schedule)</dd></div>
                <div>
                    <dt>@Tr("Status")</dt>
                    <dd>@(rule.Mode == RecurringMode.Confirm ? Tr("Added as pending, waiting for your ✓") : Tr("Added automatically as completed"))</dd>
                </div>
                @if (r.Type == RecordType.Transfer)
                {
                    <div><dt>@Tr("Transfer")</dt><dd>@AccountName(w, r.AccountId) → @AccountName(w, r.TransferAccountId)</dd></div>
                }
                else
                {
                    <div><dt>@Tr("Category")</dt><dd>@(w.Categories.FirstOrDefault(c => c.Id == r.CategoryId)?.Name ?? Tr("No category"))</dd></div>
                    <div><dt>@Tr("Account")</dt><dd>@AccountName(w, r.AccountId)</dd></div>
                }
            </dl>
            <p class="muted">@Tr("Not added yet: the record appears on its date.")</p>
        </div>
        <div class="record-details__actions">
            <a class="btn btn-primary" href="@($"recurring/{rule.Id}")"><Icon Name="edit" /> @Tr("Edit the rule")</a>
        </div>
    }
</Sheet>

@* Confirm all for Planned: the records shown there, all to one status. *@
<PlannedChoice Open="_choiceAll" Count="_planned.Count" Closed="() => _choiceAll = false"
               Chosen="s => ConfirmManyAsync(_planned.ToList(), s)" />

@code {
    private Guid? _valuing;

    private bool _confirmAll;
    private IReadOnlyList<RecordItem> _planned = [];
    private bool _choiceAll;

    // The tapped upcoming occurrence; _occurrenceShown keeps the sheet's content while it animates out.
    private (RecurringRuleItem Rule, string Label, DateOnly Date)? _occurrence;
    private (RecurringRuleItem Rule, string Label, DateOnly Date)? _occurrenceShown;

    private static string AccountName(WalletSnapshot w, Guid? id) => w.Accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    private IReadOnlyList<RecordItem> _recent = [];
    private IReadOnlyList<PinnedChartItem> _pins = [];
    private IReadOnlyList<TemplateItem> _templates = [];
    private RecordSummary? _month;
    private BudgetOverview? _budgets;
    private IReadOnlyList<RecordItem> _pending = [];
    private IReadOnlyList<(RecurringRuleItem Rule, int Index, DateOnly Date)> _upcoming = [];
    private bool _busy;
    private WalletSnapshot? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var wallet = WalletState.Current;
        if (wallet is null || ReferenceEquals(wallet, _loadedFor))
        {
            return;
        }

        _loadedFor = wallet;

        // Warms the cache, so the record form opens with suggestions.
        _ = WalletState.GetSuggestionsAsync();
        var result = await Api.GetAsync<DashboardData>($"api/wallets/{wallet.Id}/dashboard?today={DateTime.Now:yyyy-MM-dd}");
        if (result.Value is not { } data)
        {
            return;
        }

        var until = DateOnly.FromDateTime(DateTime.Now).AddDays(30);
        _upcoming = data.Recurring
            .SelectMany(r => RecurringText.Upcoming(r, until).Select(o => (r, o.Index, o.Date)))
            .OrderBy(o => o.Date)
            .Take(10)
            .ToList();
        _pending = data.Pending;
        _planned = data.Planned;
        _recent = data.Recent;
        _pins = data.PinnedCharts;
        _templates = data.PinnedTemplates;
        _month = data.Month;
        _budgets = data.Budgets;
    }

    private Task ConfirmAllAsync()
    {
        _confirmAll = false;
        return ConfirmManyAsync(_pending.ToList());
    }

    private async Task UnpinAsync(PinnedChartItem pin)
    {
        var result = await Api.DeleteAsync($"api/wallets/{WalletState.Current!.Id}/pinned-charts/{pin.Id}");
        if (result.Ok)
        {
            _pins = _pins.Where(p => p.Id != pin.Id).ToList();
            Toasts.Show(Tr("Unpinned: {0}", pin.Title));
        }
        else
        {
            Toasts.ShowError();
        }
    }

    // Confirm all; single records are confirmed in RecordList.
    private async Task ConfirmManyAsync(IReadOnlyList<RecordItem> records, RecordStatus status = RecordStatus.Completed)
    {
        _choiceAll = false;
        _busy = true;
        var failed = await RecordConfirm.ConfirmAsync(Api, WalletState.Current!.Id, records, status);
        _busy = false;
        var pending = status == RecordStatus.Pending;
        Toasts.Show(failed == 0
                ? (records.Count == 1
                    ? Tr(pending ? "Marked as pending." : "Marked as completed.")
                    : Plural(records.Count, pending ? "{0} record marked as pending." : "{0} record marked as completed.",
                        pending ? "{0} records marked as pending." : "{0} records marked as completed."))
                : Tr("{0} couldn't be changed.", failed),
            failed == 0 ? ToastKind.Success : ToastKind.Error);
        await WalletState.RefreshAsync();
    }
}
