@page "/accounts"
@attribute [Authorize]
@using BM2.Client.Components.Accounts
@using BM2.Contracts.Accounts
@using BM2.Contracts.Wallets
@using BM2.Client.Components.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>@Tr("Accounts") · BM2</PageTitle>

<header class="page-header page-header--back">
    <BackButton Fallback="more" />
    <h1 class="page-title">@Tr("Accounts")</h1>
    @if (Wallet?.Permissions.ManageAccounts == true)
    {
        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenEditor(null)"><Icon Name="plus" /> @Tr("New")</button>
    }
</header>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else if (Wallet.Accounts.Count == 0)
{
    <EmptyState IconName="bank" Title="@Tr("No accounts yet")">
        @Tr("Add cash, a bank account or savings to start tracking money.")
    </EmptyState>
}
else
{
    <ul class="list stagger">
        @foreach (var account in Wallet.Accounts.Where(a => !a.IsArchived))
        {
            <li>@Row(account)</li>
        }
    </ul>

    @if (Wallet.Accounts.Any(a => a.IsArchived))
    {
        <details class="disclosure">
            <summary class="section-title">@Tr("Archived")</summary>
            <ul class="list">
                @foreach (var account in Wallet.Accounts.Where(a => a.IsArchived))
                {
                    <li>@Row(account)</li>
                }
            </ul>
        </details>
    }
}

@if (Wallet is not null)
{
    <Sheet Open="_editorOpen" OpenChanged="v => _editorOpen = v" Title="@(_editing?.Name ?? Tr("New account"))">
        <AccountForm @key="_editing?.Id" WalletId="Wallet.Id" Account="_editing" DefaultCurrency="@Wallet.BaseCurrency"
                     OnSaved="OnSavedAsync" />
        @if (_editing is not null)
        {
            <button type="button" class="btn btn-ghost btn-block danger-text" @onclick="AskDelete">
                <Icon Name="trash" /> @Tr("Delete account")
            </button>
        }
    </Sheet>

    <ValuationSheet WalletId="Wallet.Id" Account="@Wallet.Accounts.FirstOrDefault(a => a.Id == _valuing)"
                    Open="_valuing is not null" OpenChanged="v => { if (!v) _valuing = null; }" OnChanged="WalletState.RefreshAsync">
        @if (Wallet.Permissions.ManageAccounts)
        {
            <button type="button" class="btn btn-ghost btn-block" @onclick="EditValued"><Icon Name="edit" /> @Tr("Edit account")</button>
        }
    </ValuationSheet>

    <ConfirmDialog Open="_confirmDelete" OpenChanged="v => _confirmDelete = v" Title="@Tr("Delete {0}?", _editing?.Name)"
                   ConfirmLabel="@Tr("Delete account")" Danger="true" RequireText="@_editing?.Name" OnConfirm="DeleteAsync">
        <p>@Tr("The account and all its records will be deleted, including transfers to other accounts. This can't be undone.")</p>
        <p class="muted">@Tr("To keep the history, archive the account instead.")</p>
    </ConfirmDialog>
}

@code {
    private bool _editorOpen;
    private bool _confirmDelete;
    private AccountItem? _editing;
    private Guid? _valuing;

    /// <summary>Opens the valuation sheet of this investment account (linked from Home).</summary>
    [SupplyParameterFromQuery(Name = "account")] public Guid? ValuingId { get; set; }

    private WalletSnapshot? Wallet => WalletState.Current;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _valuing = ValuingId;
    }

    private RenderFragment Row(AccountItem account) =>
        @<ListRow Title="@account.Name" Subtitle="@Subtitle(account)" OnClick="@ClickOf(account)">
            <Leading><Icon Name="@(account.Kind == AccountKind.Investment ? "trend" : "bank")" /></Leading>
            <Trailing><span class="secret"><Amount Value="account.Valuation ?? account.Balance" Currency="@account.Currency" /></span></Trailing>
        </ListRow>;

    private static string Subtitle(AccountItem account) =>
        string.Join(" · ", new[] { account.Currency, account.Kind == AccountKind.Investment ? Tr("Investment") : null, account.IsArchived ? Tr("Archived") : null }
            .OfType<string>());

    // Investment accounts open their value and valuations; others the editor.
    private EventCallback ClickOf(AccountItem account) =>
        account.Kind == AccountKind.Investment ? EventCallback.Factory.Create(this, () => _valuing = account.Id)
        : Wallet!.Permissions.ManageAccounts ? EventCallback.Factory.Create(this, () => OpenEditor(account))
        : default;

    private void EditValued()
    {
        var account = Wallet!.Accounts.FirstOrDefault(a => a.Id == _valuing);
        _valuing = null;
        OpenEditor(account);
    }

    private void OpenEditor(AccountItem? account)
    {
        _editing = account;
        _editorOpen = true;
    }

    private async Task OnSavedAsync()
    {
        _editorOpen = false;
        await WalletState.RefreshAsync();
        Toasts.Show(Tr("Account saved."), ToastKind.Success);
    }

    private void AskDelete()
    {
        _editorOpen = false;
        _confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        var result = await Api.DeleteAsync($"api/wallets/{Wallet!.Id}/accounts/{_editing!.Id}");
        _confirmDelete = false;
        if (result.Ok)
        {
            await WalletState.RefreshAsync();
            Toasts.Show(Tr("Account deleted."));
        }
        else
        {
            Toasts.ShowError();
        }
    }
}
