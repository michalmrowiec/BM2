@page "/stats"
@attribute [Authorize]
@using System.Globalization
@using BM2.Client.Components.Records
@using BM2.Client.Components.Stats
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Categories
@using BM2.Contracts.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api

<PageTitle>Stats · BM2</PageTitle>

<header class="page-header">
    <h1 class="page-title">Stats</h1>
</header>
<p class="muted">Completed income and expenses only; transfers between accounts are left out. Currencies are never mixed.</p>

@if (Wallet is null)
{
    <WalletPlaceholder />
}
else
{
    <EditForm Model="_filters" class="stats-filters card">
        <SegmentedControl Label="Period" Options="PeriodOptions" Value="_period" ValueChanged="(Period p) => SetPeriodAsync(p)" />
        @if (_period == Period.Custom)
        {
            <div class="stats-filters__row">
                <DateField Label="From" @bind-Value="_filters.From" @bind-Value:after="ReloadAsync" />
                <DateField Label="To (inclusive)" @bind-Value="_filters.To" @bind-Value:after="ReloadAsync" />
            </div>
        }
        else
        {
            <div class="month-nav">
                <button type="button" class="icon-button" aria-label="@($"Previous {PeriodNoun}")" @onclick="() => MoveAsync(-1)"><Icon Name="arrow-left" /></button>
                <span class="month-nav__label">@PeriodLabel</span>
                <button type="button" class="icon-button" aria-label="@($"Next {PeriodNoun}")" @onclick="() => MoveAsync(1)"><Icon Name="arrow-right" /></button>
            </div>
        }
        <div class="stats-filters__row">
            <SelectField Label="Account" Options="AccountOptions" @bind-Value="_filters.AccountId" @bind-Value:after="ReloadAsync" />
            @if (Currencies.Count > 1)
            {
                <SelectField Label="Currency" Options="Currencies.Select(c => ((string?)c, c)).ToList()" @bind-Value="_filters.Currency"
                             @bind-Value:after="ChangeCurrencyAsync" Hint="Only accounts in this currency are counted." />
            }
        </div>
    </EditForm>

    @* 1. By category *@
    <section class="stats-section" aria-labelledby="stats-categories">
        <div class="stats-section__head">
            <h2 class="section-title" id="stats-categories">By category</h2>
            <SegmentedControl Label="Record type" Options="TypeOptions" Value="_type" ValueChanged="(RecordType t) => SetTypeAsync(t)" />
        </div>
        @if (_categories is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (Slices.Count == 0)
        {
            <EmptyState IconName="chart" Title="@($"No {TypeNoun} in this period")">
                Try another period, account or currency.
            </EmptyState>
        }
        else
        {
            var total = Slices.Sum(s => s.Total);
            <div class="stats-split">
                <Chart Class="chart--donut" Options="_donut" OnItemClick="SelectCategoryAsync"
                       Label="@($"{TypeTitle} by category, {Money(total)} in total. The list shows every amount.")" />
                <ul class="stats-list">
                    @for (var i = 0; i < Slices.Count; i++)
                    {
                        var slice = Slices[i];
                        var swatch = SwatchOf(i);
                        <li @key="slice.CategoryId">
                            <ListRow Title="@NameOf(slice.CategoryId)"
                                     Subtitle="@($"{Share(slice.Total, total)} · {slice.Count} {(slice.Count == 1 ? "record" : "records")}")"
                                     Class="@(slice.CategoryId is not null && slice.CategoryId == _trendCategoryId ? "stats-list__row is-selected" : "stats-list__row")"
                                     OnClick="() => SelectCategoryAsync(slice.CategoryId?.ToString() ?? string.Empty)">
                                <Leading>
                                    <span class="stats-swatch stats-swatch--@swatch" aria-hidden="true"></span>
                                    <RecordAvatar Category="CategoryOf(slice.CategoryId)" Type="_type" Fallback="?" />
                                </Leading>
                                <Trailing><Amount Value="Signed(slice.Total, _type)" Currency="@Currency" /></Trailing>
                            </ListRow>
                        </li>
                    }
                </ul>
            </div>
            <p class="stats-total">Total <Amount Value="Signed(total, _type)" Currency="@Currency" /></p>
            <p class="muted stats-hint">Choose a category to see its last 12 months.</p>
        }

        @* 3. Category trend *@
        @if (_trendCategoryId is { } trendId && _trend is not null)
        {
            <div class="stats-trend card">
                <div class="stats-section__head">
                    <h3 class="stats-trend__title">@NameOf(trendId) · last 12 months</h3>
                    <button type="button" class="icon-button" aria-label="Close category trend" @onclick="CloseTrend"><Icon Name="close" /></button>
                </div>
                <Chart Options="_trendChart" Label="@($"Monthly {TypeNoun} for {NameOf(trendId)}. The table below lists every month.")" />
                <MonthTable Items="_trend.Items" Currency="@Currency" Only="_type" />
            </div>
        }
    </section>

    @* 2. Income and expenses by month *@
    <section class="stats-section" aria-labelledby="stats-months">
        <h2 class="section-title" id="stats-months">Income and expenses · 12 months</h2>
        @if (_monthly is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            var income = _monthly.Items.Sum(m => m.Income);
            var expense = _monthly.Items.Sum(m => m.Expense);
            <p class="stats-total">
                Income <Amount Value="income" Currency="@Currency" /> · Expenses <Amount Value="-expense" Currency="@Currency" />
                · Net <Amount Value="income - expense" Currency="@Currency" />
            </p>
            <Chart Options="_monthChart" Label="Income, expenses and net per month for the last 12 months. The table below lists every month." />
            <MonthTable Items="_monthly.Items" Currency="@Currency" />
        }
    </section>

    @* 4. Tag report *@
    <section class="stats-section" aria-labelledby="stats-tag">
        <h2 class="section-title" id="stats-tag">Tag report</h2>
        @if (TagOptions.Count == 1)
        {
            <p class="muted">Add tags to records to see a report per tag, like a trip or a renovation.</p>
        }
        else
        {
            <EditForm Model="_filters">
                <SelectField Label="Tag" Options="TagOptions" @bind-Value="_filters.TagId" @bind-Value:after="LoadTagAsync"
                             Hint="Totals for the selected period; months for the last 12." />
            </EditForm>
            @if (_filters.TagId is { } tagId && _tagCategories is not null && _tagMonthly is not null)
            {
                var spent = _tagCategories.Items.Where(i => i.Type == RecordType.Expense).Sum(i => i.Total);
                var earned = _tagCategories.Items.Where(i => i.Type == RecordType.Income).Sum(i => i.Total);
                <p class="stats-total">
                    Expenses <Amount Value="-spent" Currency="@Currency" /> · Income <Amount Value="earned" Currency="@Currency" />
                </p>
                @if (_tagCategories.Items.Count == 0)
                {
                    <p class="muted">No records with this tag in the selected period.</p>
                }
                else
                {
                    <ul class="stats-list">
                        @foreach (var item in _tagCategories.Items)
                        {
                            <li @key="(item.CategoryId, item.Type)">
                                <ListRow Title="@NameOf(item.CategoryId)" Subtitle="@($"{item.Count} {(item.Count == 1 ? "record" : "records")}")">
                                    <Leading><RecordAvatar Category="CategoryOf(item.CategoryId)" Type="item.Type" Fallback="?" /></Leading>
                                    <Trailing><Amount Value="Signed(item.Total, item.Type)" Currency="@Currency" /></Trailing>
                                </ListRow>
                            </li>
                        }
                    </ul>
                }
                <Chart Options="_tagChart" Label="Monthly income and expenses with this tag. The table below lists every month." />
                <MonthTable Items="_tagMonthly.Items" Currency="@Currency" />
            }
        }
    </section>
}

@code {
    private const string NumberFont = "Fraunces, ui-serif, Georgia, serif";
    private const int MaxSlices = 8;
    private static readonly string[] Palette = ["vivid", "blue", "green", "amber", "violet", "teal", "pink", "orange", "red"];

    private static readonly IReadOnlyList<(Period, string)> PeriodOptions =
        [(Period.Month, "Month"), (Period.Year, "Year"), (Period.Custom, "Custom")];

    private static readonly IReadOnlyList<(RecordType, string)> TypeOptions =
        [(RecordType.Expense, "Expenses"), (RecordType.Income, "Income")];

    private readonly FilterModel _filters = new();
    private Period _period = Period.Month;
    private DateOnly _anchor = new(DateTime.Now.Year, DateTime.Now.Month, 1);
    private RecordType _type = RecordType.Expense;
    private WalletSnapshot? _loadedFor;

    private CategoryTotals? _categories;
    private MonthlyTotals? _monthly;
    private Guid? _trendCategoryId;
    private MonthlyTotals? _trend;
    private CategoryTotals? _tagCategories;
    private MonthlyTotals? _tagMonthly;
    private object _donut = new();
    private object _monthChart = new();
    private object _trendChart = new();
    private object _tagChart = new();

    private enum Period { Month, Year, Custom }

    private WalletSnapshot? Wallet => WalletState.Current;

    private string Currency => _filters.Currency ?? Wallet?.BaseCurrency ?? "";

    private string PeriodNoun => _period == Period.Year ? "year" : "month";

    private string PeriodLabel => _period == Period.Year ? _anchor.Year.ToString(CultureInfo.CurrentCulture) : _anchor.ToString("MMMM yyyy");

    private string TypeNoun => _type == RecordType.Income ? "income" : "expenses";

    private string TypeTitle => _type == RecordType.Income ? "Income" : "Expenses";

    private IReadOnlyList<string> Currencies => Wallet is null
        ? []
        : Wallet.Accounts.Select(a => a.Currency).Append(Wallet.BaseCurrency).Distinct().Order().ToList();

    private IReadOnlyList<(Guid?, string)> AccountOptions => Wallet is null
        ? []
        : [(null, "All accounts"), .. Wallet.Accounts.Where(a => a.Currency == Currency).Select(a => ((Guid?)a.Id, a.Name))];

    private IReadOnlyList<(Guid?, string)> TagOptions => Wallet is null
        ? []
        : [(null, "Choose a tag"), .. Wallet.Tags.Where(t => !t.IsArchived).Select(t => ((Guid?)t.Id, t.Name))];

    private List<CategoryTotal> Slices => _categories?.Items.Where(i => i.Type == _type).ToList() ?? [];

    // Exclusive end of the selected period.
    private (DateOnly From, DateOnly To) Range => _period switch
    {
        Period.Month => (_anchor, _anchor.AddMonths(1)),
        Period.Year => (new DateOnly(_anchor.Year, 1, 1), new DateOnly(_anchor.Year + 1, 1, 1)),
        _ => (_filters.From, _filters.To.AddDays(1)),
    };

    // The 12 months ending with the period's last month.
    private (DateOnly From, DateOnly To) MonthRange
    {
        get
        {
            var last = Range.To.AddDays(-1);
            var to = new DateOnly(last.Year, last.Month, 1).AddMonths(1);
            return (to.AddMonths(-12), to);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Wallet is null || ReferenceEquals(Wallet, _loadedFor))
        {
            return;
        }

        if (_loadedFor?.Id != Wallet.Id)
        {
            _filters.Currency = Wallet.BaseCurrency;
            _filters.AccountId = null;
            _filters.TagId = null;
            _trendCategoryId = null;
        }

        _loadedFor = Wallet;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Wallet is null || (_period == Period.Custom && _filters.To < _filters.From))
        {
            return;
        }

        var (from, to) = Range;
        var months = MonthRange;
        var categories = Api.GetAsync<CategoryTotals>(Url("categories", from, to));
        var monthly = Api.GetAsync<MonthlyTotals>(Url("monthly", months.From, months.To));
        _categories = (await categories).Value;
        _monthly = (await monthly).Value;
        BuildDonut();
        if (_monthly is not null)
        {
            _monthChart = MonthChart(_monthly, null);
        }

        await LoadTrendAsync();
        await LoadTagAsync();
    }

    private string Url(string endpoint, DateOnly from, DateOnly to, Guid? categoryId = null, Guid? tagId = null) =>
        $"api/wallets/{Wallet!.Id}/stats/{endpoint}" + new StatsFilter
        {
            From = from, To = to, AccountId = _filters.AccountId, Currency = Currency, CategoryId = categoryId, TagId = tagId,
        }.ToQueryString();

    private async Task SetPeriodAsync(Period period)
    {
        if (period == Period.Custom)
        {
            (_filters.From, _filters.To) = (Range.From, Range.To.AddDays(-1));
        }

        _period = period;
        await ReloadAsync();
    }

    private async Task MoveAsync(int step)
    {
        _anchor = _anchor.AddMonths(_period == Period.Year ? 12 * step : step);
        await ReloadAsync();
    }

    private async Task ChangeCurrencyAsync()
    {
        _filters.AccountId = null;
        await ReloadAsync();
    }

    private async Task SetTypeAsync(RecordType type)
    {
        _type = type;
        BuildDonut();
        await LoadTrendAsync();
    }

    private async Task SelectCategoryAsync(string key)
    {
        if (Guid.TryParse(key, out var id))
        {
            _trendCategoryId = id;
            await LoadTrendAsync();
        }
    }

    private void CloseTrend()
    {
        _trendCategoryId = null;
        _trend = null;
    }

    private async Task LoadTrendAsync()
    {
        // A category of the other type has no bars to show.
        if (_trendCategoryId is not { } id
            || CategoryOf(id) is { } category && (category.Type == CategoryType.Income ? RecordType.Income : RecordType.Expense) != _type)
        {
            CloseTrend();
            return;
        }

        var months = MonthRange;
        _trend = (await Api.GetAsync<MonthlyTotals>(Url("monthly", months.From, months.To, categoryId: id))).Value;
        if (_trend is not null)
        {
            _trendChart = MonthChart(_trend, _type);
        }
    }

    private async Task LoadTagAsync()
    {
        if (_filters.TagId is not { } tagId)
        {
            _tagCategories = null;
            _tagMonthly = null;
            return;
        }

        var (from, to) = Range;
        var months = MonthRange;
        var categories = Api.GetAsync<CategoryTotals>(Url("categories", from, to, tagId: tagId));
        var monthly = Api.GetAsync<MonthlyTotals>(Url("monthly", months.From, months.To, tagId: tagId));
        _tagCategories = (await categories).Value;
        _tagMonthly = (await monthly).Value;
        if (_tagMonthly is not null)
        {
            _tagChart = MonthChart(_tagMonthly, null);
        }
    }

    private void BuildDonut()
    {
        var slices = Slices;
        var total = slices.Sum(s => s.Total);
        var data = slices.Select((s, i) => (object)new
        {
            id = s.CategoryId?.ToString() ?? "",
            name = NameOf(s.CategoryId),
            value = s.Total,
            itemStyle = new { color = $"var({TokenOf(SwatchOf(i))})" },
        }).ToList();

        _donut = new
        {
            tooltip = new { trigger = "item", formatter = "{b}<br/>{c} " + Currency + " ({d}%)" },
            title = new
            {
                text = total.ToString("N0", CultureInfo.CurrentCulture),
                subtext = Currency,
                left = "center",
                top = "38%",
                textStyle = new { color = "var(--ink)", fontFamily = NumberFont, fontSize = 22, fontWeight = 600 },
                subtextStyle = new { color = "var(--ink-muted)" },
            },
            series = new object[]
            {
                new
                {
                    type = "pie",
                    radius = new[] { "58%", "86%" },
                    label = new { show = false },
                    itemStyle = new { borderColor = "var(--sheet)", borderWidth = 2 },
                    data,
                },
            },
        };
    }

    // Bars per month; only: one series of that type, otherwise income, expenses and a net line.
    private object MonthChart(MonthlyTotals totals, RecordType? only)
    {
        var labels = totals.Items.Select(m => m.Month.ToString("MMM yy", CultureInfo.CurrentCulture)).ToList();
        var series = new List<object>();
        if (only != RecordType.Expense)
        {
            series.Add(Bars("Income", totals.Items.Select(m => m.Income), only is null ? "var(--positive)" : "var(--vivid)"));
        }

        if (only != RecordType.Income)
        {
            series.Add(Bars("Expenses", totals.Items.Select(m => m.Expense), only is null ? "var(--negative)" : "var(--vivid)"));
        }

        if (only is null)
        {
            series.Add(new
            {
                name = "Net",
                type = "line",
                data = totals.Items.Select(m => m.Income - m.Expense).ToList(),
                symbol = "circle",
                symbolSize = 6,
                lineStyle = new { color = "var(--ink)", width = 2 },
                itemStyle = new { color = "var(--ink)" },
            });
        }

        return new
        {
            grid = new { left = 4, right = 8, top = only is null ? 36 : 12, bottom = 4, containLabel = true },
            legend = new { show = only is null, top = 0, icon = "roundRect", textStyle = new { color = "var(--ink-muted)" } },
            tooltip = new { trigger = "axis" },
            xAxis = new
            {
                type = "category",
                data = labels,
                axisTick = new { show = false },
                axisLine = new { lineStyle = new { color = "var(--rule)" } },
                axisLabel = new { color = "var(--ink-muted)" },
            },
            yAxis = new
            {
                type = "value",
                splitLine = new { lineStyle = new { color = "var(--rule)" } },
                axisLabel = new { color = "var(--ink-muted)", fontFamily = NumberFont },
            },
            series,
        };
    }

    private static object Bars(string name, IEnumerable<decimal> values, string color) => new
    {
        name,
        type = "bar",
        data = values.ToList(),
        barMaxWidth = 18,
        itemStyle = new { color, borderRadius = new[] { 4, 4, 0, 0 } },
    };

    private static string SwatchOf(int index) => index < MaxSlices ? Palette[index % Palette.Length] : "muted";

    private static string TokenOf(string swatch) => swatch switch
    {
        "vivid" => "--vivid",
        "muted" => "--ink-muted",
        _ => $"--tag-{swatch}",
    };

    private CategoryItem? CategoryOf(Guid? id) => id is null ? null : Wallet?.Categories.FirstOrDefault(c => c.Id == id);

    private string NameOf(Guid? id) => id is null ? "No category" : CategoryOf(id)?.Name ?? "Deleted category";

    private static decimal Signed(decimal total, RecordType type) => type == RecordType.Expense ? -total : total;

    private static string Share(decimal part, decimal total) =>
        total == 0 ? "0%" : (part / total).ToString("P1", CultureInfo.CurrentCulture);

    private string Money(decimal value) => $"{value.ToString("N2", CultureInfo.CurrentCulture)} {Currency}";

    private sealed class FilterModel
    {
        public DateOnly From { get; set; } = new(DateTime.Now.Year, DateTime.Now.Month, 1);

        public DateOnly To { get; set; } = DateOnly.FromDateTime(DateTime.Now);

        public Guid? AccountId { get; set; }

        public string? Currency { get; set; }

        public Guid? TagId { get; set; }
    }
}
