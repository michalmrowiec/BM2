@page "/more"
@attribute [Authorize]
@inject IJSRuntime JS

<PageTitle>More · BM2</PageTitle>

<h1 class="page-title">More</h1>

@if (RendererInfo.IsInteractive)
{
    <MeGreeting />
}

<ul class="menu-list">
    <li>
        <a href="wallets">
            <Icon Name="wallet" />
            <span>Wallets</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="accounts">
            <Icon Name="bank" />
            <span>Accounts</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="members">
            <Icon Name="users" />
            <span>Members and invitations</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="categories">
            <Icon Name="category" />
            <span>Categories</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="budgets">
            <Icon Name="piggy" />
            <span>Budgets</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="templates">
            <Icon Name="bolt" />
            <span>Templates</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="recurring">
            <Icon Name="repeat" />
            <span>Recurring</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="tags">
            <Icon Name="tag" />
            <span>Tags</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <a href="Account/Manage">
            <Icon Name="user" />
            <span>Account and security</span>
            <Icon Name="chevron-right" Class="menu-list__trail" />
        </a>
    </li>
    <li>
        <button type="button" data-theme-toggle>
            <Icon Name="contrast" />
            <span>Switch theme</span>
            <span class="menu-list__trail">System · Light · Dark</span>
        </button>
    </li>
    @if (RendererInfo.IsInteractive)
    {
        @* Saved in this browser, like the theme; big totals stay in the display font. *@
        <li>
            <button type="button" aria-pressed="@(_plainAmounts ? "true" : "false")" @onclick="ToggleAmountsAsync">
                <Icon Name="type" />
                <span>Plain font for amounts</span>
                <span class="menu-list__trail">@(_plainAmounts ? "On" : "Off")</span>
            </button>
        </li>
        <li>
            <button type="button" aria-haspopup="dialog" @onclick="() => _accentOpen = true">
                <span class="accent-swatch accent-swatch--@_accent" aria-hidden="true"></span>
                <span>Accent color</span>
                <span class="menu-list__trail">@AccentName(_accent)</span>
            </button>
        </li>
    }
    <li>
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="" />
            <button type="submit">
                <Icon Name="logout" />
                <span>Log out</span>
            </button>
        </form>
    </li>
</ul>

<Sheet Open="_accentOpen" OpenChanged="v => _accentOpen = v" Title="Accent color">
    <p class="muted">Colors the add button, links and highlights. Applies right away and is saved in this browser.</p>
    <ul class="menu-list accent-picker">
        @foreach (var (key, name) in Accents)
        {
            <li>
                <button type="button" aria-pressed="@(_accent == key ? "true" : "false")" @onclick="() => SetAccentAsync(key)">
                    <span class="accent-swatch accent-swatch--@key" aria-hidden="true"></span>
                    <span>@name</span>
                    @if (_accent == key)
                    {
                        <Icon Name="check" Class="menu-list__trail" />
                    }
                </button>
            </li>
        }
    </ul>
</Sheet>

@code {
    // Keys match data-accent in tokens.css; terracotta is the default (no attribute).
    private const string DefaultAccent = "terracotta";

    private static readonly IReadOnlyList<(string Key, string Name)> Accents =
        [(DefaultAccent, "Terracotta"), ("ochre", "Ochre"), ("ink", "Ink blue"), ("green", "Bottle green"), ("plum", "Plum")];

    private bool _plainAmounts;
    private string _accent = DefaultAccent;
    private bool _accentOpen;

    private static string AccentName(string key) => Accents.FirstOrDefault(a => a.Key == key).Name ?? "Terracotta";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _plainAmounts = await JS.InvokeAsync<string?>("bm2Prefs.get", "amounts") == "plain";
            var accent = await JS.InvokeAsync<string?>("bm2Prefs.get", "accent");
            _accent = Accents.FirstOrDefault(a => a.Key == accent).Key ?? DefaultAccent;
            StateHasChanged();
        }
    }

    private async Task ToggleAmountsAsync()
    {
        _plainAmounts = !_plainAmounts;
        await JS.InvokeVoidAsync("bm2Prefs.set", "amounts", _plainAmounts ? "plain" : null);
    }

    private async Task SetAccentAsync(string key)
    {
        _accent = key;
        await JS.InvokeVoidAsync("bm2Prefs.set", "accent", key == DefaultAccent ? null : key);
    }
}
