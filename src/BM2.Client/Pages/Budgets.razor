@page "/budgets"
@attribute [Authorize]
@using BM2.Client.Components.Budgets
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Budgets
@using System.Globalization
@using BM2.Contracts.Categories
@using BM2.Contracts.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>@Tr("Budgets") · BM2</PageTitle>

<header class="page-header page-header--back">
    <BackButton Fallback="more" />
    <h1 class="page-title">@Tr("Budgets")</h1>
    @if (CanManage && Available.Count > 0)
    {
        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenEditorAsync(null)"><Icon Name="plus" /> @Tr("New")</button>
    }
</header>
<p class="muted">@Tr("A monthly limit per expense category. It repeats every month; unused money does not carry over.")</p>

<div class="month-nav">
    <button type="button" class="icon-button" aria-label="@Tr("Previous month")" @onclick="() => MoveAsync(-1)"><Icon Name="arrow-left" /></button>
    <span class="month-nav__label">@_month.ToString("MMMM yyyy")</span>
    <button type="button" class="icon-button" aria-label="@Tr("Next month")" @onclick="() => MoveAsync(1)"><Icon Name="arrow-right" /></button>
</div>

@if (Wallet is null || _overview is null)
{
    <WalletPlaceholder />
}
else if (_overview.Items.Count == 0)
{
    <EmptyState IconName="piggy" Title="@Tr("No budgets yet")">
        <ChildContent>@Tr("Set a monthly limit for a category, like 1,000 for groceries, and see how much is left.")</ChildContent>
        <Actions>
            @if (CanManage && Available.Count > 0)
            {
                <button type="button" class="btn btn-primary" @onclick="() => OpenEditorAsync(null)">@Tr("Add budget")</button>
            }
        </Actions>
    </EmptyState>
}
else
{
    var spent = _overview.Items.Sum(b => b.Spent);
    var limit = _overview.Items.Sum(b => b.Limit);
    <p class="budget-total num secret">
        <span>@Tr("{0} of {1} {2}", spent.ToString("N2"), limit.ToString("N2"), CurrencyLabel.Of(_overview.Currency))</span>
        <span class="muted">· @(spent > limit ? Tr("over by {0}", (spent - limit).ToString("N2")) : Tr("{0} left", (limit - spent).ToString("N2")))</span>
    </p>
    <ul class="budget-list stagger">
        @foreach (var item in BudgetBar.ByUsage(_overview.Items))
        {
            <li @key="item.Id">
                @if (CanManage)
                {
                    <button type="button" class="budget-list__button" aria-label="@Tr("Edit budget for {0}", CategoryOf(item)?.Name)"
                            @onclick="() => OpenEditorAsync(item)">
                        <BudgetBar Item="item" Currency="@_overview.Currency" Category="CategoryOf(item)" />
                    </button>
                }
                else
                {
                    <BudgetBar Item="item" Currency="@_overview.Currency" Category="CategoryOf(item)" />
                }
            </li>
        }
    </ul>
}

<Sheet Open="_editorOpen" OpenChanged="v => _editorOpen = v"
       Title="@(_editing is null ? Tr("New budget") : Tr("Budget for {0}", CategoryOf(_editing)?.Name))">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-stack">
        <FluentValidator @ref="_validator" Validator="Validator" ToRequest="m => ((FormModel)m).ToRequest()" />
        @if (_editing is null)
        {
            <SelectField Label="@Tr("Category")" Options="Available" @bind-Value="_model.CategoryId" />
        }
        @if (Hint is { } hint)
        {
            <section class="budget-hint" aria-label="@Tr("Spending in recent months")">
                @if (hint.Average <= 0)
                {
                    <p class="muted">@Tr("No spending in this category in the last 12 months.")</p>
                }
                else
                {
                    var max = Math.Max(hint.Months.Max(m => m.Total), 1);
                    <ul class="budget-hint__months">
                        @foreach (var (month, total) in hint.Months)
                        {
                            <li>
                                <span class="muted">@month.ToString("MMM yyyy")</span>
                                <progress class="budget__bar" max="@max.ToString(CultureInfo.InvariantCulture)"
                                          value="@Math.Max(total, 0).ToString(CultureInfo.InvariantCulture)" aria-hidden="true"></progress>
                                <span class="num secret"><span>@total.ToString("N2")</span></span>
                            </li>
                        }
                    </ul>
                    <div class="budget-hint__summary">
                        <span class="secret"><span>@Tr("Average {0} a month", $"{hint.Average:N2} {CurrencyLabel.Of(Wallet?.BaseCurrency ?? "")}")</span></span>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _model.Limit = hint.Suggested">
                            @Tr("Set limit to {0}", $"{hint.Suggested:N0} {CurrencyLabel.Of(Wallet?.BaseCurrency ?? "")}")
                        </button>
                    </div>
                }
            </section>
        }
        <MoneyInput Label="@Tr("Monthly limit")" Currency="@Wallet?.BaseCurrency" @bind-Value="_model.Limit"
                    Hint="@Tr("Applies to every month until you change it. Only accounts in this currency count.")" />
        <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(_editing is null ? Tr("Add budget") : Tr("Save"))</button>
    </EditForm>
    @if (_editing is not null)
    {
        <button type="button" class="btn btn-ghost btn-block danger-text" disabled="@_busy" @onclick="DeleteAsync">
            <Icon Name="trash" /> @Tr("Remove budget")
        </button>
    }
</Sheet>

@code {
    private static readonly SaveBudgetRequestValidator Validator = new();
    private DateOnly _month = new(DateTime.Now.Year, DateTime.Now.Month, 1);
    private BudgetOverview? _overview;
    private WalletSnapshot? _loadedFor;
    private bool _editorOpen;
    private bool _busy;
    private BudgetItem? _editing;
    private FormModel _model = new();
    private FluentValidator? _validator;
    private CategoryMonthTotals? _history;
    private WalletSnapshot? _historyFor;

    // Full months before the current one; the hint never counts the month in progress.
    private static DateOnly ThisMonth => new(DateTime.Now.Year, DateTime.Now.Month, 1);

    private WalletSnapshot? Wallet => WalletState.Current;

    private bool CanManage => Wallet?.Permissions.ManageCategories == true;

    // Expense categories that have no budget yet.
    private IReadOnlyList<(Guid? Value, string Label)> Available => Wallet is null
        ? []
        : Wallet.Categories
            .Where(c => c.Type == CategoryType.Expense && !c.IsArchived
                && _overview?.Items.Any(b => b.CategoryId == c.Id) != true)
            .Select(c => ((Guid?)c.Id, c.Name))
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override Task OnWalletChangedAsync() => LoadAsync();

    private async Task LoadAsync(bool force = false)
    {
        if (Wallet is null || (!force && ReferenceEquals(Wallet, _loadedFor)))
        {
            return;
        }

        _loadedFor = Wallet;
        var result = await Api.GetAsync<BudgetOverview>($"api/wallets/{Wallet.Id}/budgets?month={_month:yyyy-MM-dd}");
        _overview = result.Value;
    }

    private async Task MoveAsync(int months)
    {
        _month = _month.AddMonths(months);
        await LoadAsync(force: true);
    }

    private CategoryItem? CategoryOf(BudgetItem item) => Wallet?.Categories.FirstOrDefault(c => c.Id == item.CategoryId);

    private async Task OpenEditorAsync(BudgetItem? item)
    {
        _editing = item;
        _model = item is null
            ? new FormModel { CategoryId = Available.FirstOrDefault().Value }
            : new FormModel { CategoryId = item.CategoryId, Limit = item.Limit };
        _editorOpen = true;
        if (!ReferenceEquals(_historyFor, Wallet))
        {
            _historyFor = Wallet;
            var filter = new StatsFilter { From = ThisMonth.AddMonths(-12), To = ThisMonth };
            _history = (await Api.GetAsync<CategoryMonthTotals>($"api/wallets/{Wallet!.Id}/stats/category-months{filter.ToQueryString()}")).Value;
        }
    }

    // Months from the category's first spending in the last 12 full months, its average and a limit rounded up from it.
    private BudgetHint? Hint
    {
        get
        {
            if (_history is null || _model.CategoryId is not { } id)
            {
                return null;
            }

            // Refunds already come as negative expenses.
            var totals = _history.Items.Where(i => i.CategoryId == id && i.Type == RecordType.Expense).ToDictionary(i => i.Month, i => i.Total);
            var months = new List<(DateOnly Month, decimal Total)>();
            for (var m = totals.Count == 0 ? ThisMonth : totals.Keys.Min(); m < ThisMonth; m = m.AddMonths(1))
            {
                months.Add((m, totals.GetValueOrDefault(m)));
            }

            var average = months.Count == 0 ? 0 : months.Sum(m => m.Total) / months.Count;
            var step = average <= 100 ? 10m : average <= 1000 ? 50m : 100m;
            return new BudgetHint(months, average, Math.Ceiling(average / step) * step);
        }
    }

    private sealed record BudgetHint(IReadOnlyList<(DateOnly Month, decimal Total)> Months, decimal Average, decimal Suggested);

    private async Task SaveAsync()
    {
        _busy = true;
        var result = await Api.PutAsync($"api/wallets/{Wallet!.Id}/budgets", _model.ToRequest());
        _busy = false;
        if (result.Ok)
        {
            _editorOpen = false;
            Toasts.Show(Tr("Budget saved."), ToastKind.Success);
            await LoadAsync(force: true);
        }
        else if (result.Problem!.HasFieldErrors)
        {
            _validator?.ShowServerErrors(result.Problem);
        }
        else
        {
            Toasts.ShowError();
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        var result = await Api.DeleteAsync($"api/wallets/{Wallet!.Id}/budgets/{_editing!.Id}");
        _busy = false;
        if (result.Ok)
        {
            _editorOpen = false;
            Toasts.Show(Tr("Budget removed. Records are not affected."));
            await LoadAsync(force: true);
        }
        else
        {
            Toasts.ShowError();
        }
    }

    private sealed class FormModel
    {
        public Guid? CategoryId { get; set; }

        public decimal? Limit { get; set; }

        public SaveBudgetRequest ToRequest() => new(CategoryId ?? Guid.Empty, Limit ?? 0);
    }
}
