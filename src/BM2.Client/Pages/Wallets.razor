@page "/wallets"
@attribute [Authorize]
@using BM2.Client.Components.Wallets
@using BM2.Contracts.Wallets
@inherits WalletComponentBase
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>@Tr("Wallets") · BM2</PageTitle>

<header class="page-header page-header--back">
    <BackButton Fallback="more" />
    <h1 class="page-title">@Tr("Wallets")</h1>
    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenCreate"><Icon Name="plus" /> @Tr("New")</button>
</header>

@if (!WalletState.IsLoaded)
{
    <p aria-busy="true"><span class="skeleton skeleton--line"></span><span class="sr-only">@Tr("Loading…")</span></p>
}
else
{
    <ul class="list">
        @foreach (var wallet in WalletState.Wallets)
        {
            <li>
                <ListRow Title="@wallet.Name"
                         Subtitle="@Subtitle(wallet)"
                         OnClick="() => OpenEdit(wallet)">
                    <Leading><Icon Name="wallet" /></Leading>
                    <Trailing>
                        <span class="wallet-totals">
                            @if (wallet.Totals is not { Count: > 0 } totals)
                            {
                                <span class="muted">@Tr("No accounts")</span>
                            }
                            else
                            {
                                @foreach (var total in totals)
                                {
                                    <Amount Value="total.Amount" Currency="@total.Currency"
                                            Sign="@(total.Amount < 0 ? AmountSign.Minus : AmountSign.None)" />
                                }
                            }
                        </span>
                        <Icon Name="chevron-right" />
                    </Trailing>
                </ListRow>
            </li>
        }
    </ul>
}

<Sheet Open="_sheetOpen" OpenChanged="v => _sheetOpen = v" Title="@(_editing?.Name ?? Tr("New wallet"))">
    @if (_editing is null)
    {
        <WalletForm OnSaved="OnCreatedAsync" />
    }
    else
    {
        @if (_editing.Id != WalletState.Current?.Id)
        {
            <button type="button" class="btn btn-secondary btn-block" @onclick="() => UseAsync(_editing.Id)">@Tr("Use this wallet")</button>
        }

        @if (_editing.Role == MemberRole.Owner)
        {
            <WalletForm @key="_editing.Id" WalletId="_editing.Id" Name="@_editing.Name" BaseCurrency="@_editing.BaseCurrency"
                        OnSaved="OnUpdatedAsync" />
            <button type="button" class="btn btn-ghost btn-block danger-text" @onclick="AskDelete">
                <Icon Name="trash" /> @Tr("Delete wallet")
            </button>
        }
        else
        {
            <p class="muted">@Tr("Only owners can rename or delete this wallet.")</p>
        }
    }
</Sheet>

<ConfirmDialog Open="_confirmDelete" OpenChanged="v => _confirmDelete = v" Title="@Tr("Delete wallet?")" ConfirmLabel="@Tr("Delete wallet")"
               Danger="true" RequireText="@_editing?.Name" OnConfirm="DeleteAsync">
    <p>
        @((MarkupString)Tr("All accounts, categories, tags and records in {0} will be deleted for every member. This can't be undone.",
            "<strong>" + System.Net.WebUtility.HtmlEncode(_editing?.Name) + "</strong>"))
    </p>
</ConfirmDialog>

@code {
    private bool _sheetOpen;
    private bool _confirmDelete;
    private WalletListItem? _editing;

    private string Subtitle(WalletListItem wallet) =>
        $"{Options.RoleLabel(wallet.Role)} · {wallet.BaseCurrency}"
        + (wallet.Id == WalletState.Current?.Id ? $" · {Tr("Current")}" : "");

    // Totals may be stale: record changes elsewhere only refresh the current wallet's snapshot.
    protected override async Task OnInitializedAsync()
    {
        var loaded = WalletState.IsLoaded;
        await base.OnInitializedAsync();
        if (loaded && RendererInfo.IsInteractive)
        {
            await WalletState.RefreshAllAsync();
        }
    }

    private void OpenCreate()
    {
        _editing = null;
        _sheetOpen = true;
    }

    private void OpenEdit(WalletListItem wallet)
    {
        _editing = wallet;
        _sheetOpen = true;
    }

    private async Task UseAsync(Guid walletId)
    {
        _sheetOpen = false;
        await WalletState.SelectAsync(walletId);
    }

    private async Task OnCreatedAsync(Guid walletId)
    {
        _sheetOpen = false;
        await WalletState.SelectAsync(walletId);
        Toasts.Show(Tr("Wallet created."), ToastKind.Success);
    }

    private async Task OnUpdatedAsync(Guid walletId)
    {
        _sheetOpen = false;
        await WalletState.RefreshAllAsync();
        Toasts.Show(Tr("Wallet saved."), ToastKind.Success);
    }

    private void AskDelete()
    {
        _sheetOpen = false;
        _confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        var result = await Api.DeleteAsync($"api/wallets/{_editing!.Id}");
        _confirmDelete = false;
        if (result.Ok)
        {
            await WalletState.RefreshAllAsync();
            Toasts.Show(Tr("Wallet deleted."));
        }
        else
        {
            Toasts.ShowError();
        }
    }
}
