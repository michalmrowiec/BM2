@using BM2.Contracts.Accounts
@using BM2.Contracts.Categories
@using BM2.Contracts.Records
@using BM2.Contracts.Recurring
@using BM2.Contracts.Wallets
@inject ApiClient Api
@inject ToastService Toasts

@* "Send money": an expense in the current wallet and an income in Target, as two linked records. *@
@if (_target is null)
{
    <p class="muted">@Tr("Loading {0}…", Target.Name)</p>
}
else if (FromOptions.Count == 0 || ToOptions.Count == 0 || TheirCategories.Count == 0)
{
    <p>
        @Tr("To send money you need an account you can edit in both wallets and an income category in {0}.", Target.Name)
    </p>
}
else
{
    <p class="field__hint send-money__effect">
        <Icon Name="transfer" />
        <span>
            @Tr("Adds an expense in {0} and an income in {1}.", Source.Name, Target.Name)
            @(_model.Repeat is null
                ? Tr("They stay linked: editing or deleting one can change the other.")
                : Tr("Repeats {0}: each time you confirm the expense, {1} gets the income.", RepeatLabel(_model.Repeat.Value), Target.Name))
        </span>
    </p>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form-stack">
        <MoneyInput Label="@Tr("Amount")" Large="true" Currency="@FromCurrency" @bind-Value="_model.Amount" Autofocus="true" />

        <fieldset class="send-money__side">
            <legend>@Tr("From {0}", Source.Name)</legend>
            <SelectField TValue="Guid?" Label="@Tr("Account")" Options="FromOptions" @bind-Value="_model.FromAccountId" />
            <SelectField TValue="Guid?" Label="@Tr("Your category")" Options="YourCategories" @bind-Value="_model.YourCategoryId"
                         Hint="@Tr("An expense category: how this counts in your stats.")" />
        </fieldset>

        <fieldset class="send-money__side">
            <legend>@Tr("To {0}", Target.Name)</legend>
            <SelectField TValue="Guid?" Label="@Tr("Account")" Options="ToOptions" @bind-Value="_model.ToAccountId" />
            <SelectField TValue="Guid?" Label="@Tr("Their category")" Options="TheirCategories" @bind-Value="_model.TheirCategoryId"
                         Hint="@Tr("An income category in {0}.", Target.Name)" />
            @if (ToCurrency != FromCurrency)
            {
                <MoneyInput Label="@Tr("Amount received")" Currency="@ToCurrency" @bind-Value="_model.Received" />
            }
        </fieldset>

        <DateField Label="@(_model.Repeat is null ? Tr("Date") : Tr("First time on"))" @bind-Value="_model.Date" />
        <TextField Label="@Tr("Name (optional)")" @bind-Value="_model.Name" autocomplete="off" />
        <SelectField TValue="RecurrenceFrequency?" Label="@Tr("Repeat")" Options="RepeatOptions" @bind-Value="_model.Repeat"
                     Hint="@(_model.Repeat is null ? null : Tr("Each one waits in To confirm on Home until you confirm it was sent."))" />

        <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
            @(_model.Repeat is null ? Tr("Send to {0}", Target.Name) : Tr("Repeat {0}", RepeatLabel(_model.Repeat.Value)))
        </button>
    </EditForm>
}

@code {
    private static IReadOnlyList<(RecurrenceFrequency? Value, string Label)> RepeatOptions =>
    [
        (null, Tr("Doesn't repeat")), (RecurrenceFrequency.Weekly, Tr("Weekly")), (RecurrenceFrequency.Monthly, Tr("Monthly")),
        (RecurrenceFrequency.Yearly, Tr("Yearly")),
    ];

    private FormModel _model = new();
    private WalletSnapshot? _target;
    private bool _busy;

    [Parameter, EditorRequired] public WalletSnapshot Source { get; set; } = null!;

    [Parameter, EditorRequired] public WalletListItem Target { get; set; } = null!;

    [Parameter] public EventCallback OnSent { get; set; }

    private IReadOnlyList<(Guid? Value, string Label)> FromOptions => Writable(Source);

    private IReadOnlyList<(Guid? Value, string Label)> ToOptions => Writable(_target!);

    private IReadOnlyList<(Guid? Value, string Label)> YourCategories => Categories(Source, CategoryType.Expense);

    private IReadOnlyList<(Guid? Value, string Label)> TheirCategories => Categories(_target!, CategoryType.Income);

    private string FromCurrency => Source.Accounts.FirstOrDefault(a => a.Id == _model.FromAccountId)?.Currency ?? Source.BaseCurrency;

    private string ToCurrency => _target?.Accounts.FirstOrDefault(a => a.Id == _model.ToAccountId)?.Currency ?? FromCurrency;

    protected override async Task OnInitializedAsync()
    {
        _target = (await Api.GetAsync<WalletSnapshot>($"api/wallets/{Target.Id}")).Value;
        if (_target is null)
        {
            return;
        }

        _model = new FormModel
        {
            FromAccountId = FromOptions.FirstOrDefault().Value,
            ToAccountId = ToOptions.FirstOrDefault().Value,
            YourCategoryId = YourCategories.FirstOrDefault().Value,
            TheirCategoryId = TheirCategories.FirstOrDefault().Value,
        };
    }

    private static IReadOnlyList<(Guid? Value, string Label)> Writable(WalletSnapshot wallet) => wallet.Accounts
        .Where(a => a.CanWrite && !a.IsArchived)
        .OrderBy(a => a.Kind)
        .Select(a => ((Guid?)a.Id, $"{a.Name} ({a.Currency})"))
        .ToList();

    private static IReadOnlyList<(Guid? Value, string Label)> Categories(WalletSnapshot wallet, CategoryType type) => wallet.Categories
        .Where(c => c.Type == type && !c.IsArchived)
        .Select(c => ((Guid?)c.Id, c.Name))
        .ToList();

    private static string RepeatLabel(RecurrenceFrequency frequency) => frequency switch
    {
        RecurrenceFrequency.Daily => Tr("daily"),
        RecurrenceFrequency.Weekly => Tr("weekly"),
        RecurrenceFrequency.Monthly => Tr("monthly"),
        _ => Tr("yearly"),
    };

    private async Task SubmitAsync()
    {
        if (_model.Amount is not > 0 || _model.FromAccountId is not { } from || _model.ToAccountId is not { } to
            || _model.YourCategoryId is not { } yours || _model.TheirCategoryId is not { } theirs)
        {
            Toasts.Show(Tr("Enter an amount and choose both accounts and categories."), ToastKind.Error);
            return;
        }

        var amount = _model.Amount.Value;
        var received = ToCurrency == FromCurrency ? amount : _model.Received ?? 0;
        if (received <= 0)
        {
            Toasts.Show(Tr("Enter the amount received."), ToastKind.Error);
            return;
        }

        var record = new SaveRecordRequest(
            RecordType.Expense, RecordStatus.Completed, _model.Date, from, amount, FromCurrency, amount, yours, null, null,
            string.IsNullOrWhiteSpace(_model.Name) ? null : _model.Name.Trim(), [],
            new RecordPair(Target.Id, to, theirs, received));

        _busy = true;
        var result = _model.Repeat is { } frequency
            ? await Api.PostAsync<RecurringRuleItem>(
                $"api/wallets/{Source.Id}/recurring",
                new SaveRecurringRuleRequest(
                    record, new RecurrenceSchedule(frequency, 1, _model.Date, RecurrenceEnd.Never, null, null), RecurringMode.Confirm,
                    false, null))
            : (ApiResult)await Api.PostAsync<RecordItem>($"api/wallets/{Source.Id}/records", record);
        _busy = false;

        if (!result.Ok)
        {
            Toasts.Show(result.Problem?.Detail ?? Tr("Couldn't send the money."), ToastKind.Error);
            return;
        }

        Toasts.Show(_model.Repeat is null ? Tr("Sent to {0}.", Target.Name) : Tr("Repeat saved: confirm each one on Home."), ToastKind.Success);
        await OnSent.InvokeAsync();
    }

    private sealed class FormModel
    {
        public decimal? Amount { get; set; }

        public decimal? Received { get; set; }

        public Guid? FromAccountId { get; set; }

        public Guid? ToAccountId { get; set; }

        public Guid? YourCategoryId { get; set; }

        public Guid? TheirCategoryId { get; set; }

        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Now);

        public string? Name { get; set; }

        public RecurrenceFrequency? Repeat { get; set; }
    }
}
