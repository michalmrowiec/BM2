@implements IAsyncDisposable
@inject IJSRuntime JS

@* Native <dialog>: focus trap, Escape and an inert page come from the browser. *@
<dialog @ref="_dialog" class="sheet" aria-labelledby="@_titleId" @onclose="OnClosedAsync" @onclick="RequestCloseAsync">
    <div class="sheet__panel" @onclick:stopPropagation="true">
        <header class="sheet__header">
            <h2 id="@_titleId" class="sheet__title">@Title</h2>
            <button type="button" class="icon-button" aria-label="Close" @onclick="RequestCloseAsync">
                <Icon Name="close" />
            </button>
        </header>
        @if (Open || _shown)
        {
            <div class="sheet__body">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="sheet__footer">@Footer</footer>
            }
        }
    </div>
</dialog>

@code {
    private readonly string _titleId = "sheet-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _shown;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Sheet.razor.js");
        await _module.InvokeVoidAsync(Open ? "open" : "close", _dialog);
        _shown = Open;
    }

    private Task RequestCloseAsync() => OpenChanged.InvokeAsync(false);

    // Escape closes the dialog natively; tell the parent.
    private async Task OnClosedAsync()
    {
        if (!_shown)
        {
            return;
        }

        _shown = false;
        if (Open)
        {
            await OpenChanged.InvokeAsync(false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; nothing to clean up.
            }
        }
    }
}
