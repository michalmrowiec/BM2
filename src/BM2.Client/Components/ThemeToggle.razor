@* Plain HTML button handled by wwwroot/js/theme.js, so it works on static account pages too. *@
<button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Change theme" title="Change theme">
    <Icon Name="contrast" Class="theme-icon-system" />
    <Icon Name="sun" Class="theme-icon-light" />
    <Icon Name="moon" Class="theme-icon-dark" />
</button>
