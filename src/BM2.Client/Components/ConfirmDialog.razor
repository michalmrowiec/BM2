<Sheet Open="Open" OpenChanged="OpenChanged" Title="@Title">
    <ChildContent>
        @ChildContent
        @if (RequireText is not null)
        {
            <div class="field">
                <label class="field__label" for="@_inputId">@((MarkupString)Tr("Type {0} to confirm", "<strong>" + System.Net.WebUtility.HtmlEncode(RequireText) + "</strong>"))</label>
                <input id="@_inputId" class="field__control" value="@_typed" autocomplete="off"
                       @oninput="e => _typed = e.Value?.ToString()" />
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => OpenChanged.InvokeAsync(false)">@Tr("Cancel")</button>
        <button type="button" class="btn @(Danger ? "btn-danger" : "btn-primary")" disabled="@(!CanConfirm)"
                @onclick="ConfirmAsync">
            @(ConfirmLabel ?? Tr("Confirm"))
        </button>
    </Footer>
</Sheet>

@code {
    private readonly string _inputId = "confirm-" + Guid.NewGuid().ToString("N")[..8];
    private string? _typed;
    private bool _busy;
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? ConfirmLabel { get; set; }

    [Parameter] public bool Danger { get; set; }

    /// <summary>When set, the confirm button unlocks only after the user types exactly this text.</summary>
    [Parameter] public string? RequireText { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool CanConfirm => !_busy && (RequireText is null || _typed == RequireText);

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _typed = null;
        }

        _wasOpen = Open;
    }

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
