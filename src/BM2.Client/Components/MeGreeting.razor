@using System.Net
@inject HttpClient Http
@inject NavigationManager Navigation

@if (_failed)
{
    <p role="alert">Could not load your profile. Check your connection and try again.</p>
}
else if (_me is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <p class="muted">Signed in as <strong>@_me.Email</strong></p>
}

@code {
    private MeResponse? _me;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var response = await Http.GetAsync("api/me");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                // Session no longer valid (e.g. account removed): sign in again.
                Navigation.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", forceLoad: true);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _failed = true;
                return;
            }

            _me = await response.Content.ReadFromJsonAsync<MeResponse>();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
    }
}
