@if (Href is not null)
{
    <a class="list-row @Class" href="@Href">@Content</a>
}
else if (OnClick.HasDelegate)
{
    <button type="button" class="list-row @Class" @onclick="OnClick">@Content</button>
}
else
{
    <div class="list-row @Class">@Content</div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public RenderFragment? Leading { get; set; }

    [Parameter] public RenderFragment? Trailing { get; set; }

    [Parameter] public string? Href { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    private RenderFragment Content => @<text>
        @if (Leading is not null)
        {
            <span class="list-row__leading">@Leading</span>
        }
        <span class="list-row__text">
            <span class="list-row__title">@Title</span>
            @if (Subtitle is not null)
            {
                <span class="list-row__subtitle">@Subtitle</span>
            }
        </span>
        @if (Trailing is not null)
        {
            <span class="list-row__trailing">@Trailing</span>
        }
    </text>;
}
