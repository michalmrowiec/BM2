<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@Shape</svg>

@code {
    // Simple outline glyphs drawn for BM2 (24×24 grid).
    private static readonly Dictionary<string, MarkupString> Shapes = new()
    {
        ["home"] = new("<path d=\"M3.5 10.5 12 3.5l8.5 7\"/><path d=\"M5.5 9v11h13V9\"/><path d=\"M10 20v-5.5h4V20\"/>"),
        ["list"] = new("<path d=\"M9 6.5h11M9 12h11M9 17.5h11\"/><path d=\"M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01\" stroke-width=\"2.6\"/>"),
        ["plus"] = new("<path d=\"M12 5v14M5 12h14\" stroke-width=\"2.2\"/>"),
        ["chart"] = new("<path d=\"M12 3.5a8.5 8.5 0 1 0 8.5 8.5H12z\"/><path d=\"M15 3.9A8.5 8.5 0 0 1 20.1 9H15z\"/>"),
        ["dots"] = new("<path d=\"M5 12h.01M12 12h.01M19 12h.01\" stroke-width=\"3\"/>"),
        ["sun"] = new("<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4\"/>"),
        ["moon"] = new("<path d=\"M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z\"/>"),
        ["contrast"] = new("<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 3.5a8.5 8.5 0 0 1 0 17z\" fill=\"currentColor\" stroke=\"none\"/>"),
        ["user"] = new("<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 20.5a7.5 7.5 0 0 1 15 0\"/>"),
        ["logout"] = new("<path d=\"M14 4.5h4.5v15H14\"/><path d=\"M10 8l-4 4 4 4M6 12h9\"/>"),
        ["wallet"] = new("<path d=\"M4 7.5h14.5a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z\"/><path d=\"M4 7.5 15 4l1.2 3.5\"/><path d=\"M16.5 13.5h.01\" stroke-width=\"2.6\"/>"),
        ["chevron-right"] = new("<path d=\"m9.5 6 6 6-6 6\"/>"),
        ["chevron-down"] = new("<path d=\"m6 9.5 6 6 6-6\"/>"),
        ["bank"] = new("<path d=\"M3.5 9.5 12 4.5l8.5 5\"/><path d=\"M5.5 10.5v7M10 10.5v7M14 10.5v7M18.5 10.5v7M3.5 20h17\"/>"),
        ["archive"] = new("<rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"4\" rx=\"1\"/><path d=\"M5 8.5v10.5h14V8.5M10 12.5h4\"/>"),
        ["close"] = new("<path d=\"M6.5 6.5l11 11M17.5 6.5l-11 11\"/>"),
        ["check"] = new("<path d=\"m5 12.5 4.5 4.5L19 7\"/>"),
        ["trash"] = new("<path d=\"M4.5 6.5h15M9.5 6.5v-2h5v2\"/><path d=\"m6.5 6.5 1 13h9l1-13M10 10.5v5.5M14 10.5v5.5\"/>"),
        ["edit"] = new("<path d=\"M4.5 19.5l1-4.5L15.5 5a2.1 2.1 0 0 1 3 3l-10 10z\"/><path d=\"m13.5 7 3 3\"/>"),
    };

    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public string? Class { get; set; }

    private MarkupString Shape => Shapes.TryGetValue(Name, out var shape)
        ? shape
        : throw new ArgumentException($"Unknown icon '{Name}'.", nameof(Name));
}
