@using System.Globalization

@* The currency is its own element so private mode can keep it ("*** zł"). *@
<span class="amount num @SignClass @(Large ? "amount--large" : null)" @key="Key"><span>@Number</span>@(" ")<span class="amount__currency">@CurrencyText</span></span>

@code {
    [Parameter] public decimal Value { get; set; }

    [Parameter, EditorRequired] public string Currency { get; set; } = "";

    [Parameter] public AmountSign Sign { get; set; } = AmountSign.Auto;

    [Parameter] public bool Large { get; set; }

    private AmountSign Effective => Sign switch
    {
        AmountSign.Auto when Value > 0 => AmountSign.Plus,
        AmountSign.Auto when Value < 0 => AmountSign.Minus,
        AmountSign.Auto => AmountSign.None,
        _ => Sign,
    };

    private string? SignClass => Effective switch
    {
        AmountSign.Plus => "amount--positive",
        AmountSign.Minus => "amount--negative",
        _ => null,
    };

    // Minus is U+2212 so it lines up with the plus sign.
    private string Number => Effective switch
    {
        AmountSign.Plus => "+",
        AmountSign.Minus => "−",
        _ => "",
    } + Math.Abs(Value).ToString("N2", CultureInfo.CurrentCulture);

    private string CurrencyText => CurrencyLabel.Of(Currency);

    // A new key replays the entrance animation when the amount changes.
    private string Key => Number + " " + CurrencyText;
}
