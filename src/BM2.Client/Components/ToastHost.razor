@implements IDisposable
@inject ToastService Toasts

<div class="toast-host" role="status" aria-live="polite">
    @foreach (var toast in Toasts.Items)
    {
        <div class="toast toast--@toast.Kind.ToString().ToLowerInvariant()" @key="toast.Id">
            <span>@toast.Message</span>
            <button type="button" class="icon-button" aria-label="Dismiss" @onclick="() => Toasts.Dismiss(toast.Id)">
                <Icon Name="close" />
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= OnChanged;
}
