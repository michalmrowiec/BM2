@implements IAsyncDisposable
@inject ToastService Toasts
@inject IJSRuntime JS

@* A manual popover lives in the top layer; raising it again puts toasts above an open modal sheet. *@
<div @ref="_host" class="toast-host" popover="manual" role="status" aria-live="polite">
    @foreach (var toast in Toasts.Items)
    {
        <div class="toast toast--@toast.Kind.ToString().ToLowerInvariant()" @key="toast.Id">
            <span>@toast.Message</span>
            <button type="button" class="icon-button" aria-label="Dismiss" @onclick="() => Toasts.Dismiss(toast.Id)">
                <Icon Name="close" />
            </button>
        </div>
    }
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private int _raisedFor = -1;

    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        // Raise on first render and whenever a toast was added since the last raise.
        var count = Toasts.Items.Count;
        if (firstRender || count > _raisedFor)
        {
            _raisedFor = count;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/ToastHost.razor.js");
            await _module.InvokeVoidAsync("raise", _host);
        }
        else
        {
            _raisedFor = count;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Toasts.Changed -= OnChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page unloaded.
            }
        }
    }
}
