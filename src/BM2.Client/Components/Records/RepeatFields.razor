@using System.Globalization
@using BM2.Contracts.Recurring

@* Schedule part of the record form: every N days/weeks/months/years, an optional end and the confirm mode. *@
<div class="repeat-fields">
    <div class="repeat-fields__every">
        <label class="field__label" for="repeat-interval">Every</label>
        <input id="repeat-interval" class="field__control repeat-fields__interval" type="number" inputmode="numeric" min="1" max="366"
               value="@Model.Interval" @onchange="e => Model.Interval = ParseInt(e.Value, 1)" />
        <select class="field__control" aria-label="Repeat unit" value="@Model.Frequency"
                @onchange="e => Model.Frequency = Enum.Parse<RecurrenceFrequency>(e.Value!.ToString()!)">
            @foreach (var (value, label) in Units)
            {
                <option value="@value">@(Model.Interval == 1 ? label : label + "s")</option>
            }
        </select>
    </div>

    <SegmentedControl TValue="RecurrenceEnd" Options="EndOptions" Value="Model.End" ValueChanged="v => Model.End = v" Label="Ends" />

    @if (Model.End == RecurrenceEnd.OnDate)
    {
        <div class="field">
            <label class="field__label" for="repeat-until">Last date</label>
            <input id="repeat-until" class="field__control" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                   @onchange="e => Model.EndDate = DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d) ? d : null" />
        </div>
    }
    else if (Model.End == RecurrenceEnd.AfterCount)
    {
        <div class="field">
            <label class="field__label" for="repeat-count">Times (installments get "k/N" in the name)</label>
            <input id="repeat-count" class="field__control" type="number" inputmode="numeric" min="1" max="1000" value="@Model.Count"
                   @onchange="e => Model.Count = ParseInt(e.Value, 12)" />
        </div>
    }

    <label class="check">
        <input type="checkbox" checked="@Model.Confirm" @onchange="e => Model.Confirm = e.Value is true" />
        <span>Ask me to confirm each one (adds it as pending)</span>
    </label>

    <p class="field__hint">@Model.Describe(Start)</p>
</div>

@code {
    private static readonly IReadOnlyList<(RecurrenceFrequency Value, string Label)> Units =
        [(RecurrenceFrequency.Daily, "day"), (RecurrenceFrequency.Weekly, "week"), (RecurrenceFrequency.Monthly, "month"), (RecurrenceFrequency.Yearly, "year")];

    private static readonly IReadOnlyList<(RecurrenceEnd Value, string Label)> EndOptions =
        [(RecurrenceEnd.Never, "Never"), (RecurrenceEnd.OnDate, "On date"), (RecurrenceEnd.AfterCount, "After N times")];

    [Parameter, EditorRequired] public RepeatModel Model { get; set; } = null!;

    /// <summary>The first occurrence (the record date or the rule start).</summary>
    [Parameter] public DateOnly Start { get; set; }

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) && n > 0 ? n : fallback;
}
