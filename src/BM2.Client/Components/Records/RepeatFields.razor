@using System.Globalization
@using BM2.Contracts.Records
@using BM2.Contracts.Recurring

@* Schedule part of the record form: every N days/weeks/months/years, an optional end and the confirm mode. *@
<div class="repeat-fields">
    <div class="repeat-fields__every">
        <label class="field__label" for="repeat-interval">@Tr("Every")</label>
        <input id="repeat-interval" class="field__control repeat-fields__interval" type="number" inputmode="numeric" min="1" max="366"
               value="@Model.Interval" @onchange="e => Model.Interval = ParseInt(e.Value, 1)" />
        <div class="field__select">
            <select class="field__control" aria-label="@Tr("Repeat unit")" value="@Model.Frequency"
                    @onchange="e => Model.Frequency = Enum.Parse<RecurrenceFrequency>(e.Value!.ToString()!)">
                @foreach (var value in Units)
                {
                    <option value="@value">@UnitLabel(value)</option>
                }
            </select>
            <Icon Name="chevron-down" Class="field__select-icon" />
        </div>
    </div>

    <div class="field">
        <span class="field__label" aria-hidden="true">@Tr("Ends")</span>
        <SegmentedControl TValue="RecurrenceEnd" Options="EndOptions" Value="Model.End" ValueChanged="SetEnd" Label="@Tr("Ends")" />
    </div>

    @if (Model.End == RecurrenceEnd.OnDate)
    {
        <DateField id="repeat-until" Label="@Tr("Last date")" Shortcuts="false" @bind-Value="Model.LastDate" />
    }
    else if (Model.End == RecurrenceEnd.AfterCount)
    {
        <div class="field">
            <label class="field__label" for="repeat-count">@Tr("Times (installments get \"k/N\" in the name)")</label>
            <input id="repeat-count" class="field__control" type="number" inputmode="numeric" min="1" max="1000" value="@Model.Count"
                   @onchange="e => Model.Count = ParseInt(e.Value, 12)" />
        </div>
    }

    <div class="field">
        <label class="field__label" for="repeat-mode">@Tr("Next records are added as")</label>
        <div class="field__select">
            <select id="repeat-mode" class="field__control" value="@(Model.Confirm ? "pending" : "completed")"
                    @onchange="SetMode">
                <option value="completed">@Tr("Completed (counted right away)")</option>
                <option value="pending">@Tr("Pending (wait for my ✓ on Home)")</option>
            </select>
            <Icon Name="chevron-down" Class="field__select-icon" />
        </div>
    </div>

    <div class="repeat-fields__effect" role="status">
        <p class="repeat-fields__rule">@Model.Describe(Start)</p>
        @foreach (var line in Model.Effect(Start, FirstStatus, FirstExists, Existing, DateOnly.FromDateTime(DateTime.Now)))
        {
            <p>@line</p>
        }
    </div>
</div>

@code {
    private static readonly RecurrenceFrequency[] Units =
        [RecurrenceFrequency.Daily, RecurrenceFrequency.Weekly, RecurrenceFrequency.Monthly, RecurrenceFrequency.Yearly];

    private static IReadOnlyList<(RecurrenceEnd Value, string Label)> EndOptions =>
        [(RecurrenceEnd.Never, Tr("Never")), (RecurrenceEnd.OnDate, Tr("On date")), (RecurrenceEnd.AfterCount, Tr("N times"))];

    // Unit name agreeing with the interval number ("1 week", "3 weeks", "5 weeks").
    private string UnitLabel(RecurrenceFrequency f) => f switch
    {
        RecurrenceFrequency.Daily => Plural(Model.Interval, "day", "days"),
        RecurrenceFrequency.Weekly => Plural(Model.Interval, "week", "weeks"),
        RecurrenceFrequency.Monthly => Plural(Model.Interval, "month", "months"),
        _ => Plural(Model.Interval, "year", "years"),
    };

    [Parameter, EditorRequired] public RepeatModel Model { get; set; } = null!;

    // A last date starts a year after the first occurrence.
    private void SetEnd(RecurrenceEnd end)
    {
        Model.End = end;
        if (end == RecurrenceEnd.OnDate)
        {
            Model.EndDate ??= Start.AddYears(1);
        }
    }

    /// <summary>The first occurrence (the record date or the rule start).</summary>
    [Parameter] public DateOnly Start { get; set; }

    /// <summary>Status of the record saved now as the first occurrence; null when only the rule is saved.</summary>
    [Parameter] public RecordStatus? FirstStatus { get; set; }

    /// <summary>The first occurrence is an existing record ("Make recurring"), not one saved now.</summary>
    [Parameter] public bool FirstExists { get; set; }

    /// <summary>The rule being edited.</summary>
    [Parameter] public RecurringRuleItem? Existing { get; set; }

    private void SetMode(ChangeEventArgs e) => Model.Confirm = e.Value?.ToString() == "pending";

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) && n > 0 ? n : fallback;
}
