@using BM2.Contracts.Records
@using BM2.Contracts.Wallets

<Sheet Open="Open" OpenChanged="OpenChanged" Title="@Tr("Filters")">
    <ChildContent>
        <EditForm Model="_model" OnSubmit="ApplyAsync" class="form-stack" id="record-filters">
            <SelectField TValue="Guid?" id="filter-account" Label="@Tr("Account")" Options="AccountOptions" @bind-Value="_model.AccountId" />
            <SelectField TValue="Guid?" id="filter-category" Label="@Tr("Category")" Options="CategoryOptions" @bind-Value="_model.CategoryId" />
            @if (Wallet.Tags.Count > 0)
            {
                <SelectField TValue="Guid?" id="filter-tag" Label="@Tr("Tag")" Options="TagOptions" @bind-Value="_model.TagId" />
            }
            <SelectField TValue="RecordType?" id="filter-type" Label="@Tr("Type")" Options="TypeOptions" @bind-Value="_model.Type" />
            <SelectField TValue="RecordStatus?" id="filter-status" Label="@Tr("Status")" Options="StatusOptions" @bind-Value="_model.Status" />
            <SelectField TValue="bool?" id="filter-source" Label="@Tr("Added by")" Options="SourceOptions" @bind-Value="_model.Recurring" />
        </EditForm>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="ClearAsync">@Tr("Clear")</button>
        <button type="submit" form="record-filters" class="btn btn-primary">@Tr("Show records")</button>
    </Footer>
</Sheet>

@code {
    private static IReadOnlyList<(RecordType? Value, string Label)> TypeOptions =>
        [(null, Tr("All types")), (RecordType.Expense, Tr("Expenses")), (RecordType.Income, Tr("Income")), (RecordType.Transfer, Tr("Transfers"))];

    private static IReadOnlyList<(RecordStatus? Value, string Label)> StatusOptions =>
        [(null, Tr("Any status")), (RecordStatus.Completed, Tr("Completed")), (RecordStatus.Pending, Tr("Pending")), (RecordStatus.Planned, Tr("Planned"))];

    private static IReadOnlyList<(bool? Value, string Label)> SourceOptions =>
        [(null, Tr("Anyone")), (true, Tr("Recurring rules only"))];

    private FilterModel _model = new();
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public WalletSnapshot Wallet { get; set; } = null!;

    [Parameter, EditorRequired] public RecordFilter Value { get; set; } = new();

    [Parameter] public EventCallback<RecordFilter> ValueChanged { get; set; }

    private IReadOnlyList<(Guid? Value, string Label)> AccountOptions =>
        [(null, Tr("All accounts")), .. Wallet.Accounts.Select(a => ((Guid?)a.Id, a.Name))];

    private IReadOnlyList<(Guid? Value, string Label)> CategoryOptions =>
        [(null, Tr("All categories")), .. Wallet.Categories.OrderBy(c => c.Type).ThenBy(c => c.Name).Select(c => ((Guid?)c.Id, c.Name))];

    private IReadOnlyList<(Guid? Value, string Label)> TagOptions =>
        [(null, Tr("All tags")), .. Wallet.Tags.Select(t => ((Guid?)t.Id, t.Name))];

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _model = new FilterModel
            {
                AccountId = Value.AccountId,
                CategoryId = Value.CategoryId,
                TagId = Value.TagId,
                Type = Value.Type,
                Status = Value.Status,
                Recurring = Value.Recurring,
            };
        }

        _wasOpen = Open;
    }

    private async Task ApplyAsync()
    {
        await ValueChanged.InvokeAsync(new RecordFilter
        {
            AccountId = _model.AccountId,
            CategoryId = _model.CategoryId,
            TagId = _model.TagId,
            Type = _model.Type,
            Status = _model.Status,
            Recurring = _model.Recurring,
        });
        await OpenChanged.InvokeAsync(false);
    }

    private async Task ClearAsync()
    {
        await ValueChanged.InvokeAsync(new RecordFilter());
        await OpenChanged.InvokeAsync(false);
    }

    private sealed class FilterModel
    {
        public Guid? AccountId { get; set; }

        public Guid? CategoryId { get; set; }

        public Guid? TagId { get; set; }

        public RecordType? Type { get; set; }

        public RecordStatus? Status { get; set; }

        public bool? Recurring { get; set; }
    }
}
