@using BM2.Contracts.Categories
@using FluentValidation
@inject ToastService Toasts

@* Name (+ icon for categories or color for tags, + archived flag when editing): shared by categories and tags. *@
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form-stack">
    <FluentValidator @ref="_validator" Validator="Validator" ToRequest="m => ToRequest((NameFormModel)m)" />
    <TextField Label="@Tr("Name")" @bind-Value="_model.Name" autocomplete="off" />
    @if (ShowIcon)
    {
        <div class="field">
            <span class="field__label" id="@($"{_id}-icon")">@Tr("Icon")</span>
            <div class="icon-picker" role="group" aria-labelledby="@($"{_id}-icon")">
                <button type="button" class="icon-picker__item" aria-pressed="@Pressed(_model.Icon is null)" @onclick="() => _model.Icon = null">
                    @Tr("None")
                </button>
                @foreach (var key in CategoryIcons.All)
                {
                    <button type="button" class="icon-picker__item" aria-label="@key" aria-pressed="@Pressed(_model.Icon == key)"
                            @onclick="() => _model.Icon = key">
                        <Icon Name="@key" />
                    </button>
                }
            </div>
        </div>
    }
    @if (ShowColor)
    {
        <div class="field">
            <span class="field__label">@Tr("Color")</span>
            <TagColorPicker Value="@_model.Color" ValueChanged="c => _model.Color = c" />
        </div>
    }
    @if (ShowArchived)
    {
        <label class="check">
            <InputCheckbox @bind-Value="_model.IsArchived" />
            <span>@Tr("Archived") <span class="muted">· @(ArchivedHint ?? Tr("hidden when adding records"))</span></span>
        </label>
    }
    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(SubmitLabel ?? Tr("Save"))</button>
</EditForm>

@code {
    private readonly string _id = "name-form-" + Guid.NewGuid().ToString("N")[..8];
    private NameFormModel _model = new();
    private FluentValidator? _validator;
    private bool _busy;

    [Parameter] public string? Name { get; set; }

    [Parameter] public bool IsArchived { get; set; }

    [Parameter] public bool ShowArchived { get; set; }

    [Parameter] public string? CategoryIcon { get; set; }

    [Parameter] public bool ShowIcon { get; set; }

    [Parameter] public string? TagColor { get; set; }

    [Parameter] public bool ShowColor { get; set; }

    [Parameter] public string? ArchivedHint { get; set; }

    [Parameter] public string? SubmitLabel { get; set; }

    [Parameter, EditorRequired] public IValidator Validator { get; set; } = null!;

    [Parameter, EditorRequired] public Func<NameFormModel, object> ToRequest { get; set; } = null!;

    [Parameter, EditorRequired] public Func<NameFormModel, Task<ApiResult>> Save { get; set; } = null!;

    [Parameter] public EventCallback OnSaved { get; set; }

    protected override void OnInitialized() => _model = new NameFormModel { Name = Name, IsArchived = IsArchived, Icon = CategoryIcon, Color = TagColor };

    private static string Pressed(bool on) => on ? "true" : "false";

    private async Task SubmitAsync()
    {
        _busy = true;
        var result = await Save(_model);
        _busy = false;

        if (result.Ok)
        {
            await OnSaved.InvokeAsync();
        }
        else if (result.Problem!.HasFieldErrors)
        {
            _validator?.ShowServerErrors(result.Problem);
        }
        else
        {
            Toasts.ShowError();
        }
    }
}
