@using System.Globalization
@using BM2.Client.Components.Records
@using BM2.Contracts.Records
@using BM2.Contracts.Wallets
@inject ApiClient Api

@* The records behind a chart bar or a list row: same filters as the stats (no planned, one currency). *@
@* Renders the last query (_loaded), so the content stays while the sheet animates out. *@
<Sheet Open="Query is not null" OpenChanged="v => { if (!v) Closed.InvokeAsync(); }" Title="@(_loaded?.Title ?? "Records")">
    @if (_loaded is null)
    {
    }
    else if (_items is null)
    {
        <p class="muted" aria-busy="true">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">No records.</p>
    }
    else
    {
        <p class="records-preview__total">
            @StatsCharts.Records(_items.Count)
            <Amount Value="_items.Sum(i => i.AccountAmount)" Currency="@_loaded.Currency" Sign="TemplateText.Sign(_loaded.Type)" />
        </p>
        <ul class="list records-preview">
            @foreach (var item in _items)
            {
                var category = Wallet.Categories.FirstOrDefault(c => c.Id == item.CategoryId);
                var title = item.Name ?? category?.Name ?? item.Type.ToString();
                <li @key="item.Id">
                    <ListRow Title="@title" Subtitle="@Subtitle(item, category?.Name)" Href="@($"records/{item.Id}")">
                        <Leading><RecordAvatar Category="category" Type="item.Type" Fallback="@title" /></Leading>
                        <Trailing><Amount Value="item.AccountAmount" Currency="@_loaded.Currency" Sign="TemplateText.Sign(item.Type)" /></Trailing>
                    </ListRow>
                </li>
            }
        </ul>
        @if (_more)
        {
            <p class="muted">Showing the latest @_items.Count. Use Show in Records to see all.</p>
        }
    }
    @if (_loaded?.TagIds is not { Count: > 1 })
    {
        @* Records filters by one tag, so the link is offered for zero or one. *@
        <a class="btn btn-secondary btn-block records-preview__open" href="@RecordsHref(_loaded)"><Icon Name="list" /> Show in Records</a>
    }
</Sheet>

@code {
    private const int Limit = 50;
    private RecordsPreviewQuery? _loaded;
    private List<RecordItem>? _items;
    private bool _more;

    [Parameter, EditorRequired] public WalletSnapshot Wallet { get; set; } = null!;

    /// <summary>What to show; null keeps the sheet closed.</summary>
    [Parameter] public RecordsPreviewQuery? Query { get; set; }

    [Parameter] public EventCallback Closed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Query is null || ReferenceEquals(Query, _loaded))
        {
            return;
        }

        _loaded = Query;
        _items = null;
        var query = Query;

        // The API takes one tag; several tags are asked one by one and merged ("any of the tags").
        IEnumerable<Guid?> tags = query.TagIds is { Count: > 0 } ids ? ids.Select(id => (Guid?)id) : [null];
        var items = new Dictionary<Guid, RecordItem>();
        _more = false;
        foreach (var tagId in tags)
        {
            var filter = new RecordFilter
            {
                From = query.From,
                To = query.To,
                Type = query.Type,
                AccountId = query.AccountId,
                CategoryId = query.CategoryId,
                TagId = tagId,
                Limit = Limit,
            };
            var page = (await Api.GetAsync<RecordPage>($"api/wallets/{Wallet.Id}/records{filter.ToQueryString()}")).Value;
            foreach (var item in page?.Items ?? [])
            {
                items.TryAdd(item.Id, item);
            }

            _more |= page?.NextCursor is not null;
        }

        if (ReferenceEquals(query, Query))
        {
            _items = items.Values
                .Where(i => i.Status != RecordStatus.Planned && CurrencyOf(i.AccountId) == query.Currency)
                .OrderByDescending(i => i.OccurredOn)
                .ToList();
        }
    }

    /// <summary>The Records page with the same period and filters (a whole month opens in month mode).</summary>
    private static string RecordsHref(RecordsPreviewQuery? query)
    {
        if (query is null)
        {
            return "records";
        }

        var parts = new List<string>();
        if (query.From.Day == 1 && query.To == query.From.AddMonths(1))
        {
            parts.Add("month=" + query.From.ToString("yyyy-MM", CultureInfo.InvariantCulture));
        }
        else
        {
            parts.Add("from=" + query.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
            parts.Add("to=" + query.To.AddDays(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
        }

        parts.Add("type=" + query.Type);
        if (query.AccountId is { } account)
        {
            parts.Add("accountId=" + account);
        }

        if (query.CategoryId is { } category)
        {
            parts.Add("categoryId=" + category);
        }

        if (query.TagIds?.FirstOrDefault() is { } tag && tag != Guid.Empty)
        {
            parts.Add("tagId=" + tag);
        }

        return "records?" + string.Join("&", parts);
    }

    private string? CurrencyOf(Guid accountId) => Wallet.Accounts.FirstOrDefault(a => a.Id == accountId)?.Currency;

    private static string Subtitle(RecordItem item, string? category)
    {
        var parts = new[] { item.OccurredOn.ToString("d MMM", CultureInfo.CurrentCulture), item.Name is null || item.Name == category ? null : category, item.AccountName };
        return string.Join(" · ", parts.OfType<string>());
    }
}
