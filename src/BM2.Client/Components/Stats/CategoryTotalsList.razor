@using BM2.Client.Components.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets

@* Category totals as text: icon, share, record count and amount; optional color swatches matching a donut.
   With OnToggle the swatch is a checkbox that leaves the category out; shares then count only the rest. *@
<ul class="stats-list">
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        var swatch = StatsCharts.SwatchOf(i);
        var selectable = OnSelect.HasDelegate && item.CategoryId is not null;
        var hidden = IsHidden(item);
        var toggles = OnToggle.HasDelegate;
        var name = StatsCharts.NameOf(Wallet, item.CategoryId);
        <li @key="(item.CategoryId, item.Type)" class="@(toggles ? hidden ? "stats-list__item is-hidden" : "stats-list__item" : null)">
            @if (toggles)
            {
                <label class="stats-toggle" title="@(hidden ? Tr("Include in chart and total") : Tr("Leave out of chart and total"))">
                    <input type="checkbox" checked="@(!hidden)" @onchange="() => OnToggle.InvokeAsync(item.CategoryId)"
                           aria-label="@Tr("Include {0}", name)" />
                    <span class="stats-swatch stats-swatch--@swatch" aria-hidden="true"></span>
                </label>
            }
            <ListRow Title="@name"
                     Subtitle="@(hidden ? Tr("Left out · {0}", StatsCharts.Records(item.Count)) : $"{StatsCharts.Share(item.Total, Total)} · {StatsCharts.Records(item.Count)}")"
                     Class="@(selectable && item.CategoryId == SelectedId ? "stats-list__row is-selected" : "stats-list__row")"
                     OnClick="@(selectable ? EventCallback.Factory.Create(this, () => OnSelect.InvokeAsync(item.CategoryId!.Value)) : default)">
                <Leading>
                    @if (Swatches && !toggles)
                    {
                        <span class="stats-swatch stats-swatch--@swatch" aria-hidden="true"></span>
                    }
                    <RecordAvatar Category="StatsCharts.CategoryOf(Wallet, item.CategoryId)" Type="item.Type" Fallback="?" />
                </Leading>
                <Trailing><Amount Value="StatsCharts.Signed(item.Total, item.Type)" Currency="@Currency" /></Trailing>
            </ListRow>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CategoryTotal> Items { get; set; } = [];

    [Parameter, EditorRequired] public WalletSnapshot Wallet { get; set; } = null!;

    [Parameter, EditorRequired] public string Currency { get; set; } = "";

    [Parameter] public bool Swatches { get; set; }

    [Parameter] public Guid? SelectedId { get; set; }

    [Parameter] public EventCallback<Guid> OnSelect { get; set; }

    [Parameter] public IReadOnlySet<Guid?>? Hidden { get; set; }

    [Parameter] public EventCallback<Guid?> OnToggle { get; set; }

    private decimal Total => Items.Where(i => !IsHidden(i)).Sum(i => i.Total);

    private bool IsHidden(CategoryTotal item) => Hidden?.Contains(item.CategoryId) == true;
}
