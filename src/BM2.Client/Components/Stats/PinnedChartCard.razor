@using System.Globalization
@using BM2.Contracts.Records
@using BM2.Contracts.Stats
@using BM2.Contracts.Wallets
@inject ApiClient Api

@* A pinned stats view on Home: small chart, one line of numbers, link to the full screen and Unpin. *@
<article class="card pinned-chart">
    <header class="pinned-chart__header">
        <a class="pinned-chart__title" href="@Href">@Pin.Title</a>
        <button type="button" class="icon-button" aria-label="@Tr("Unpin {0}", Pin.Title)" title="@Tr("Unpin")" @onclick="() => OnUnpin.InvokeAsync(Pin)">
            <Icon Name="close" />
        </button>
    </header>
    @if (_failed)
    {
        <p class="muted">@Tr("Could not load this chart.")</p>
    }
    else if (_options is null)
    {
        <p aria-busy="true"><span class="skeleton skeleton--line"></span><span class="sr-only">@Tr("Loading…")</span></p>
    }
    else
    {
        <p class="pinned-chart__figure">@_figure</p>
        <Chart Options="_options" Label="@($"{Pin.Title}: {_figureText}")" Class="chart--small" />
    }
</article>

@code {
    private PinnedChartItem? _loaded;
    private object? _options;
    private RenderFragment? _figure;
    private string _figureText = "";
    private bool _failed;

    [Parameter, EditorRequired] public WalletSnapshot Wallet { get; set; } = null!;

    [Parameter, EditorRequired] public PinnedChartItem Pin { get; set; } = null!;

    [Parameter] public EventCallback<PinnedChartItem> OnUnpin { get; set; }

    private string Href => Pin.Kind switch
    {
        PinnedChartKind.Categories => "stats/categories",
        PinnedChartKind.Tags => "stats/tags",
        PinnedChartKind.Forecast => "stats/forecast",
        _ => "stats/monthly",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || ReferenceEquals(_loaded, Pin))
        {
            return;
        }

        _loaded = Pin;
        var (url, type) = PinnedChartQueries.ApiUrl(Wallet.Id, Pin, DateOnly.FromDateTime(DateTime.Now));
        switch (Pin.Kind)
        {
            case PinnedChartKind.Categories:
                var totals = (await Api.GetAsync<CategoryTotals>(url)).Value;
                if (totals is null) { _failed = true; return; }
                var slices = totals.Items.Where(i => i.Type == type).ToList();
                var total = slices.Sum(s => s.Total);
                _options = StatsCharts.Donut(slices.Select(s => (s.CategoryId?.ToString() ?? "none", StatsCharts.NameOf(Wallet, s.CategoryId), s.Total)).ToList(), totals.Currency);
                SetFigure(type == RecordType.Income ? Tr("Income") : Tr("Expenses"), StatsCharts.Signed(total, type), totals.Currency,
                    slices.Count > 0 ? Tr("top: {0}", StatsCharts.NameOf(Wallet, slices[0].CategoryId)) : Tr("no records"));
                break;
            case PinnedChartKind.Forecast:
                var forecast = (await Api.GetAsync<ForecastData>(url)).Value;
                if (forecast is null) { _failed = true; return; }
                _options = StatsCharts.Forecast(forecast.Points);
                SetFigure(Tr("On {0}", forecast.Points[^1].Date.ToString("d MMM", CultureInfo.CurrentCulture)), forecast.End, forecast.Currency,
                    Tr("lowest {0} on {1}", forecast.Lowest.Balance.ToString("N0", CultureInfo.CurrentCulture), forecast.Lowest.Date.ToString("d MMM", CultureInfo.CurrentCulture)));
                break;
            default:
                var monthly = (await Api.GetAsync<MonthlyTotals>(url)).Value;
                if (monthly is null) { _failed = true; return; }
                _options = StatsCharts.Months(monthly.Items);
                SetFigure(Tr("Net, 12 months"), monthly.Items.Sum(m => m.Income - m.Expense), monthly.Currency, null);
                break;
        }
    }

    private void SetFigure(string label, decimal value, string currency, string? note)
    {
        _figureText = $"{label} {value.ToString("N2", CultureInfo.CurrentCulture)} {CurrencyLabel.Of(currency)}" + (note is null ? "" : $", {note}");
        _figure = @<text>@label <Amount Value="value" Currency="@currency" />@(note is null ? "" : $" · {note}")</text>;
    }
}
