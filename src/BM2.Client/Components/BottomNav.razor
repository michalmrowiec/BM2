@implements IDisposable
@inject NavigationManager Navigation

<nav class="bottom-nav" aria-label="Main">
    <a href="" class="bottom-nav__item" aria-current="@Current("")">
        <Icon Name="home" /><span>Home</span>
    </a>
    <a href="records" class="bottom-nav__item" aria-current="@Current("records")">
        <Icon Name="list" /><span>Records</span>
    </a>
    <a href="@AddHref" class="bottom-nav__fab" aria-label="Add record">
        <Icon Name="plus" /><span class="bottom-nav__fab-label">Add record</span>
    </a>
    <a href="stats" class="bottom-nav__item" aria-current="@Current("stats")">
        <Icon Name="chart" /><span>Stats</span>
    </a>
    @* Large screens only: the side rail has room for what phones reach through More. *@
    @foreach (var (href, icon, label) in RailOnly)
    {
        @if (href is null)
        {
            <span class="bottom-nav__group bottom-nav__item--rail">@label</span>
        }
        else
        {
            <a href="@href" class="bottom-nav__item bottom-nav__item--rail" aria-current="@Current(href)">
                <Icon Name="@icon" /><span>@label</span>
            </a>
        }
    }
    <a href="more" class="bottom-nav__item" aria-current="@Current("more")">
        <Icon Name="dots" /><span>More</span>
    </a>
</nav>

@code {
    private const string QuickAddPath = "records/new";

    // A null href is a group heading.
    private static readonly (string? Href, string Icon, string Label)[] RailOnly =
    [
        ("budgets", "piggy", "Budgets"),
        ("recurring", "repeat", "Recurring"),
        ("templates", "bolt", "Templates"),
        (null, "", "Manage"),
        ("wallets", "wallet", "Wallets"),
        ("accounts", "bank", "Accounts"),
        ("members", "users", "Members"),
        ("categories", "category", "Categories"),
        ("tags", "tag", "Tags"),
    ];

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // On one account's records, a new record starts on that account.
    private string AddHref =>
        IsActive("records") && System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)["accountId"] is { Length: > 0 } accountId
            ? $"{QuickAddPath}?account={Uri.EscapeDataString(accountId)}"
            : QuickAddPath;

    private string? Current(string section) => IsActive(section) ? "page" : null;

    private bool IsActive(string section)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        if (section.Length == 0)
        {
            return path.Length == 0;
        }

        // Quick add is the FAB, not part of the Records section.
        return path != QuickAddPath
            && (path == section || path.StartsWith(section + "/", StringComparison.Ordinal));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
