@page "/Error"
@using System.Diagnostics

<PageTitle>@Tr("Error")</PageTitle>

<h1 class="text-danger">@Tr("Error.")</h1>
<h2 class="text-danger">@Tr("An error occurred while processing your request.")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Tr("Request ID:")</strong> <code>@RequestId</code>
    </p>
}

<h3>@Tr("Development mode")</h3>
<p>
    @Tr("Switching to the Development environment will display more detailed information about the error that occurred.")
</p>
<p>
    <strong>@Tr("The Development environment shouldn't be enabled for deployed applications.")</strong>
    @Tr("It can result in displaying sensitive information from exceptions to end users. For local debugging, set the ASPNETCORE_ENVIRONMENT environment variable to Development and restart the app.")
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
