@using BM2.Client.Localization

@inject NavigationManager NavigationManager

<p class="language-switch">
    @foreach (var language in Strings.Languages)
    {
        @if (language != Strings.Languages[0])
        {
            <span aria-hidden="true">·</span>
        }
        <a href="@Link(language.Code)" hreflang="@language.Code" lang="@language.Code" aria-current="@(language == Strings.Current ? "true" : null)">@language.Name</a>
    }
</p>

@code {
    private string Link(string language) =>
        $"culture/{language}?returnUrl={Uri.EscapeDataString("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri))}";
}
